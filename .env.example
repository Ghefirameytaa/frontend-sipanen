# ── Alamat API (wajib) ───────────────────────────────────────────────────────
#
# Seluruh pengambilan data SiPanen berjalan di sisi server, jadi alamat ini
# dibaca oleh server Astro — bukan oleh peramban.
#
# Di mesin sendiri (npm run dev), backend berjalan di port 3000:
API_BASE_URL=http://localhost:3000/api

# Di dalam Docker Compose, gunakan nama service, bukan localhost:
# API_BASE_URL=http://backend-go:3000/api

# ── Alamat API untuk peramban (belum dipakai) ────────────────────────────────
#
# Nilai ini disematkan saat BUILD, sehingga tidak dapat diubah tanpa membangun
# ulang. Sediakan hanya bila kelak ada kode yang memanggil API langsung dari
# peramban. Alamatnya harus dapat dijangkau dari komputer pengguna.
PUBLIC_API_BASE_URL=http://localhost:3000/api
