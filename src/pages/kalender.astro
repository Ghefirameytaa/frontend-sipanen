---
import MainLayout from '../layouts/MainLayout.astro';
import DataState from '../components/DataState.astro';
import IkonArahHarga from '../components/IkonArahHarga.astro';
import Ikon from '../components/Ikon.astro';
import { getFullKalenderTanam } from '../lib/api';
import { wilayahAktif } from '../lib/wilayah';

const wilayah = await wilayahAktif();
const params = Astro.url.searchParams;
const selectedParam = (params.get('komoditas') ?? '').trim().toLowerCase();

const fullKalenderRes = await getFullKalenderTanam();
const fullKalender = fullKalenderRes.ok ? fullKalenderRes.data : null;
const kalender12 = fullKalender?.kalender ?? [];
const ringkasanMusim = fullKalender?.ringkasan_musim ?? null;
const perMusim = ringkasanMusim?.per_musim ?? {};
const metadata = fullKalender?.metadata ?? {};

const rentangMusim = (jenis: string) => {
  const data = perMusim[jenis];
  if (!data) return 'Belum tersedia';
  return data.jumlah_bulan === 0 ? 'Tidak ada' : data.rentang_bulan ?? 'Belum tersedia';
};

const komoditasMapAwal = kalender12[0]?.komoditas ?? {};
const daftarKomoditas = Object.entries(komoditasMapAwal).map(([key, val]: [string, any]) => {
  const bulanEmas: string[] = [];
  const bulanCocok: string[] = [];
  for (const row of kalender12) {
    const kData = row?.komoditas?.[key];
    if (!kData) continue;
    if (kData.status === 'Cocok' && kData.tren_harga_panen === 'Naik') {
      bulanEmas.push(row.nama_bulan);
    }
    if (kData.status === 'Cocok') {
      bulanCocok.push(row.nama_bulan);
    }
  }
  const rekomendasiUtama =
    bulanEmas.length > 0
      ? `${bulanEmas.join(', ')} (Cuaca Cocok & Harga Panen Naik)`
      : bulanCocok.length > 0
        ? `${bulanCocok.join(', ')} (Cuaca Cocok)`
        : '-';

  return {
    key,
    name: val?.nama ?? key,
    hst: val?.durasi_hari,
    satuan: val?.satuan_durasi ?? metadata?.satuan_umur_tanam ?? 'HST',
    rekomendasiUtama,
  };
});

const defaultKomoditasKey =
  daftarKomoditas.find(
    (k) => k.key.toLowerCase() === selectedParam || k.name.toLowerCase() === selectedParam
  )?.key ??
  daftarKomoditas[0]?.key ??
  'cabai_rawit_merah';

const musimStyle = (kat?: string, label?: string) => {
  return { badge: 'bg-slate-100 text-slate-700 border-slate-200', text: label || (kat === 'peralihan' ? 'Peralihan' : kat === 'kemarau' ? 'Kemarau' : 'Musim Hujan') };
};

const statusStyle = (status?: string) => {
  if (status === 'Cocok') {
    return {
      badge: 'bg-[#F1FFF1] text-[#216617] border-[#8FFF6E]',
      bar: 'bg-[#60C44A]',
    };
  }
  if (status === 'Cukup') {
    return {
      badge: 'bg-[#FFFEEF] text-[#7A6800] border-[#FFEA50]',
      bar: 'bg-[#FCDD05]',
    };
  }
  return {
    badge: 'bg-[#FFF1EF] text-[#770800] border-[#FF786F]',
    bar: 'bg-[#FF4332]',
  };
};

const statusLabel = (status?: string) => status === 'Kurang Cocok' ? 'Tidak cocok' : status ?? 'Belum tersedia';

const hargaStyle = (tren?: string) => {
  if (tren === 'Naik') return { box: 'bg-green-50 text-green-900 border-green-200', arah: 'naik' as const, label: tren };
  if (tren === 'Turun') return { box: 'bg-red-50 text-red-900 border-red-200', arah: 'turun' as const, label: tren };
  return { box: 'bg-slate-100 text-slate-800 border-slate-200', arah: 'stabil' as const, label: tren || 'Stabil' };
};

const potongPanen = (val?: string) => (val ? val.replace(/\s*\(.*?\)/g, '') : '-');
---

<MainLayout title="Kalender Tanam" description="Kalender tanam 12 bulan berbasis model XGBoost, musim Open-Meteo, dan prediksi tren harga panen.">
  <div class="space-y-6">
    {/* Header Ringkas & Responsif */}
    <header data-page-hero class="relative isolate overflow-hidden rounded-panel bg-[#125112] px-4 py-6 text-white shadow-lg sm:px-9 sm:py-10">
      <img src="/cabai-hijau-harga.jpg" alt="Lahan budidaya cabai hijau" class="absolute inset-0 z-0 h-full w-full object-cover object-center opacity-90" width="1376" height="768" />
      <div data-page-hero-overlay class="hero-photo-overlay absolute inset-0 z-10" aria-hidden="true"></div>
      <div class="relative z-20 flex flex-wrap items-end justify-between gap-5">
        <div class="relative max-w-3xl">
          <p data-page-hero-badge class="mb-3 inline-flex max-w-full items-center gap-1.5 rounded-full bg-[#EAF2CF] px-2.5 py-1.5 text-[10px] font-bold uppercase leading-tight tracking-[0.04em] text-[#263238] sm:gap-2 sm:px-3 sm:text-sm sm:tracking-wide">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#125112]" aria-hidden="true"></span>
            <span>{wilayah.ok ? wilayah.data.name : metadata?.desa ?? 'Desa Blederan'}</span>
          </p>
          <h1 class="font-display text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">Kalender tanam</h1>
          <p class="mt-3 text-base text-green-50 sm:text-lg">
            Pilih waktu tanam dengan melihat perkiraan panen, kondisi cuaca, dan arah harga.
          </p>
        </div>
      </div>
    </header>

    {!fullKalender || kalender12.length === 0 ? (
      <DataState
        jenis="galat"
        pesan={fullKalenderRes.ok ? 'Data kalender belum tersedia.' : fullKalenderRes.error.message}
        saran="Pastikan backend aktif, lalu muat ulang halaman."
      />
    ) : (
      <>
        {/* Tombol Pilih Komoditas Instan Tanpa Reload */}
        <nav aria-label="Pilih komoditas">
          <p class="mb-2 text-sm font-semibold text-tinta-utama">Komoditas</p>
          <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
            {daftarKomoditas.map((item) => {
              const aktif = item.key === defaultKomoditasKey;
              return (
                <button
                  type="button"
                  data-komoditas-btn={item.key}
                  data-komoditas-name={item.name}
                  aria-pressed={aktif ? 'true' : 'false'}
                  class:list={[
                    'komoditas-tab-btn min-h-10 w-full cursor-pointer rounded-full border px-2 py-2 text-xs font-bold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sipanen-700 sm:w-auto sm:px-4 sm:text-sm',
                    aktif
                      ? 'border-[#B9D0AD] bg-[#DCE9D2] text-[#125112] hover:bg-[#C5D9BC]'
                      : 'border-[#C7D2DF] bg-white text-[#344054] hover:bg-[#C5D9BC]',
                  ]}
                >
                  {item.name}
                </button>
              );
            })}
          </div>
        </nav>

        {/* Panel per Komoditas (Berpindah Instan di Browser Tanpa Reload) */}
        {daftarKomoditas.map((kom) => {
          const aktif = kom.key === defaultKomoditasKey;
          return (
            <div
              data-komoditas-panel={kom.key}
              class={aktif ? 'space-y-6' : 'hidden space-y-6'}
            >
              {/* 3 Kotak Ringkasan */}
              <section class="grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label={`Ringkasan kalender tanam ${kom.name}`}>
                <article class="h-full rounded-card border border-kertas-garis border-l-4 border-l-emerald-600 bg-white p-4 shadow-sm">
                  <h3 class="text-sm font-semibold text-tinta-utama">Rekomendasi bulan terbaik</h3>
                  <p class="mt-1 text-lg font-extrabold leading-snug text-tinta-utama">{kom.rekomendasiUtama}</p>
                </article>

                <article class="h-full rounded-card border border-kertas-garis border-l-4 border-l-amber-500 bg-white p-4 shadow-sm">
                  <h3 class="text-sm font-semibold text-tinta-utama">Lama budidaya</h3>
                  <p class="mt-1 text-xl font-extrabold text-tinta-utama">{kom.hst} HST</p>
                  <p class="mt-1 text-sm text-tinta-kedua">{kom.satuan}</p>
                </article>

                <article class="h-full rounded-card border border-kertas-garis border-l-4 border-l-blue-500 bg-white p-4 shadow-sm">
                  <h3 class="text-sm font-semibold text-tinta-utama">Pola musim setempat</h3>
                  <p class="mt-1 text-xs leading-relaxed text-tinta-kedua">Rata-rata curah hujan bulanan 2010-2025</p>
                  <dl class="mt-2 space-y-1 text-sm text-tinta-utama">
                    <div class="flex flex-wrap gap-x-1"><dt class="font-semibold">Musim hujan:</dt><dd>{rentangMusim('hujan')}</dd></div>
                    <div class="flex flex-wrap gap-x-1"><dt class="font-semibold">Peralihan:</dt><dd>{rentangMusim('peralihan')}</dd></div>
                    <div class="flex flex-wrap gap-x-1"><dt class="font-semibold">Musim kemarau:</dt><dd>{rentangMusim('kemarau')}</dd></div>
                  </dl>
                </article>
              </section>

              {/* Grid 12 Bulan */}
              <section class="space-y-4 rounded-2xl border border-kertas-garis bg-white p-4 shadow-sm sm:p-5" aria-labelledby={'judul-jadwal-' + kom.key}>
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h2 id={'judul-jadwal-' + kom.key} class="font-display text-2xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-3xl">Jadwal tanam {kom.name}</h2>
                    <p class="mt-1 text-sm text-tinta-kedua">Pilih bulan untuk melihat status tanam, jadwal panen, cuaca, dan arah harga.</p>
                  </div>
                  <div class="flex flex-wrap gap-2 text-xs" aria-label="Arti warna status">
                    <span class="rounded-full border border-[#8FFF6E] bg-[#F1FFF1] px-2.5 py-1 font-semibold text-[#216617] transition-colors hover:border-[#60C44A]">Cocok</span>
                    <span class="rounded-full border border-[#FFEA50] bg-[#FFFEEF] px-2.5 py-1 font-semibold text-[#7A6800] transition-colors hover:border-[#FCDD05]">Cukup</span>
                    <span class="rounded-full border border-[#FF786F] bg-[#FFF1EF] px-2.5 py-1 font-semibold text-[#770800] transition-colors hover:border-[#FF4332]">Tidak cocok</span>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6 xl:grid-cols-12" role="group" aria-label={'Pilih bulan tanam ' + kom.name}>
                  {kalender12.map((row: any) => {
                    const item = row?.komoditas?.[kom.key];
                    if (!item) return null;
                    const dipilih = Number(row.bulan) === 1;
                    const warnaBulan = item.status === 'Cocok'
                      ? 'border-[#8FFF6E] bg-[#F1FFF1] text-[#216617] hover:border-[#60C44A]'
                      : item.status === 'Cukup'
                        ? 'border-[#FFEA50] bg-[#FFFEEF] text-[#7A6800] hover:border-[#FCDD05]'
                        : 'border-[#FF786F] bg-[#FFF1EF] text-[#770800] hover:border-[#FF4332]';
                    return (
                      <button
                        type="button"
                        class:list={['bulan-pilihan min-h-sentuh rounded-xl border px-3 py-2 text-left transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sipanen-700 xl:px-2', warnaBulan]}
                        data-bulan-pilih={row.bulan}
                        data-status={item.status}
                        aria-pressed={dipilih ? 'true' : 'false'}
                      >
                        <span class="block text-sm font-bold xl:text-xs">{row.nama_bulan}</span>
                        <span class="mt-0.5 block text-xs font-medium xl:text-[11px]">{statusLabel(item.status)}</span>
                      </button>
                    );
                  })}
                </div>

                <div class="space-y-3">
                  {kalender12.map((row: any) => {
                    const item = row?.komoditas?.[kom.key];
                    if (!item) return null;
                    const dipilih = Number(row.bulan) === 1;
                    const st = statusStyle(item.status);
                    const hg = hargaStyle(item.tren_harga_panen);
                    const musim = row.musim?.label ?? 'Belum tersedia';
                    const hujanVal = row.iklim?.hujan_mm != null ? Math.round(row.iklim.hujan_mm) + ' mm' : 'Belum tersedia';
                    const detailId = 'jadwal-' + kom.key + '-' + row.bulan;

                    return (
                      <section
                        id={detailId}
                        data-bulan-detail={row.bulan}
                        class:list={['rounded-2xl border border-kertas-garis bg-white p-4 shadow-sm sm:p-5', !dipilih && 'hidden']}
                        aria-labelledby={detailId + '-judul'}
                      >
                        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-kertas-garis pb-3">
                          <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-tinta-kedua">Jadwal tanam {kom.name}</p>
                            <h3 id={detailId + '-judul'} class="mt-1 font-display text-xl font-bold text-tinta-utama">{row.nama_bulan}</h3>
                          </div>
                          <div class="flex items-center gap-2">
                            <span class:list={['rounded-full border px-3 py-1 text-sm font-bold', st.badge]}>{statusLabel(item.status)}</span>
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-800">Skor {item.skor}/100</span>
                          </div>
                        </header>

                        <div class="mt-4 grid gap-3 sm:grid-cols-2">
                          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-sm font-semibold text-slate-900">Musim dan curah hujan historis</p>
                            <p class="mt-1 text-base font-extrabold text-slate-900">{musim} · {hujanVal}</p>
                            <p class="mt-1 text-sm leading-relaxed text-slate-700">Rata-rata klimatologi bulanan 2010 hingga 2025, bukan prakiraan cuaca harian.</p>
                          </div>
                          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-sm font-semibold text-slate-900">Perkiraan jadwal panen</p>
                            <p class="mt-1 text-base font-extrabold text-slate-900">{potongPanen(item.panen_perkiraan)}</p>
                            <p class="mt-1 text-sm text-slate-700">Sekitar {item.hst ?? kom.hst} HST setelah tanam bibit.</p>
                          </div>
                          <div class:list={['rounded-xl border p-3', hg.box]}>
                            <p class="text-sm font-semibold">Arah harga saat panen</p>
                            <p class="mt-1 flex items-center gap-2 text-base font-extrabold"><IkonArahHarga arah={hg.arah} ukuran={12} /> {hg.label}</p>
                            <p class="mt-1 text-sm leading-relaxed">Perkiraan tren musiman; bukan jaminan harga pasar.</p>
                          </div>
                          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-sm font-semibold text-slate-900">Saran tanam</p>
                            <p class="mt-1 text-sm leading-relaxed text-slate-800">{item.strategi_mitra ?? item.alasan ?? 'Belum ada saran untuk bulan ini.'}</p>
                          </div>
                        </div>

                        {(item.fase?.berbunga_berbuah || item.fase?.panen) && (
                          <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm leading-relaxed text-slate-700">
                            <p class="font-semibold text-slate-900">Cuaca pada fase penting</p>
                            {item.fase?.berbunga_berbuah && <p class="mt-1">Berbunga ({item.fase.berbunga_berbuah.nama_bulan_dominan}): sekitar {Math.round(item.fase.berbunga_berbuah.hujan_mm ?? 0)} mm.</p>}
                            {item.fase?.panen && <p class="mt-1">Panen ({item.fase.panen.nama_bulan_dominan}): sekitar {Math.round(item.fase.panen.hujan_mm ?? 0)} mm.</p>}
                          </div>
                        )}

                        {item.alasan && (
                          <p class="mt-3 flex items-start gap-2 rounded-xl bg-[#D2D2D2] p-3 text-sm leading-relaxed text-slate-700">
                            <Ikon nama="saran" ukuran={18} kelas="mt-0.5 shrink-0 text-[#216617]" />
                            <span><strong class="text-slate-900">Alasan penilaian:</strong> {item.alasan}</span>
                          </p>
                        )}
                      </section>
                    );
                  })}
                </div>
              </section>
            </div>
          );
        })}

      </>
    )}
  </div>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('[data-komoditas-btn]');
      const panels = document.querySelectorAll('[data-komoditas-panel]');
      if (!buttons.length || !panels.length) return;

      const activeBtnClasses = ['border-[#B9D0AD]', 'bg-[#DCE9D2]', 'text-[#125112]', 'hover:bg-[#C5D9BC]'];
      const inactiveBtnClasses = ['border-[#C7D2DF]', 'bg-white', 'text-[#344054]', 'hover:bg-[#C5D9BC]'];

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetKey = btn.getAttribute('data-komoditas-btn');
          const targetName = btn.getAttribute('data-komoditas-name');
          if (!targetKey) return;

          buttons.forEach((b) => {
            const isMatch = b.getAttribute('data-komoditas-btn') === targetKey;
            b.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
            const sub = b.querySelector('[data-komoditas-sub]');
            if (isMatch) {
              b.classList.remove(...inactiveBtnClasses);
              b.classList.add(...activeBtnClasses);
              if (sub) {
                sub.classList.remove('text-tinta-kedua');
                sub.classList.add('text-sipanen-100');
              }
            } else {
              b.classList.remove(...activeBtnClasses);
              b.classList.add(...inactiveBtnClasses);
              if (sub) {
                sub.classList.remove('text-sipanen-100');
                sub.classList.add('text-tinta-kedua');
              }
            }
          });

          panels.forEach((panel) => {
            if (panel.getAttribute('data-komoditas-panel') === targetKey) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });

          if (targetName && window.history && window.history.replaceState) {
            const url = new URL(window.location.href);
            url.searchParams.set('komoditas', targetName);
            window.history.replaceState({}, '', url.toString());
          }
        });
      });

      document.querySelectorAll('[data-bulan-pilih]').forEach((button) => {
        button.addEventListener('click', () => {
          const panel = button.closest('[data-komoditas-panel]');
          const bulan = button.getAttribute('data-bulan-pilih');
          if (!panel || !bulan) return;

          panel.querySelectorAll('[data-bulan-pilih]').forEach((pilihan) => {
            pilihan.setAttribute('aria-pressed', pilihan === button ? 'true' : 'false');
          });
          panel.querySelectorAll('[data-bulan-detail]').forEach((detail) => {
            detail.classList.toggle('hidden', detail.getAttribute('data-bulan-detail') !== bulan);
          });
        });
      });
    })();
  </script>

  <style>
    .bulan-pilihan {
      transition: transform 220ms ease, box-shadow 220ms ease, outline-color 220ms ease;
    }

    @media (hover: hover) {
      .bulan-pilihan:hover {
        position: relative;
        z-index: 1;
        box-shadow: 0 5px 12px rgb(38 50 56 / 16%);
        transform: translateY(-3px);
      }
    }

    .bulan-pilihan[aria-pressed='true'] {
      position: relative;
      z-index: 1;
      outline: 1px solid currentColor;
      outline-offset: 0;
      box-shadow: 0 5px 12px rgb(38 50 56 / 18%);
      transform: none;
    }

    .bulan-pilihan[aria-pressed='true'][data-status='Cocok'] {
      outline-color: #8FFF6E;
    }

    .bulan-pilihan[aria-pressed='true'][data-status='Cukup'] {
      outline-color: #FFEA50;
    }

    .bulan-pilihan[aria-pressed='true'][data-status='Kurang Cocok'] {
      outline-color: #FF786F;
    }

    @media (prefers-reduced-motion: reduce) {
      .bulan-pilihan {
        transition: none;
      }

      .bulan-pilihan[aria-pressed='true'] {
        transform: none;
      }

      .bulan-pilihan:hover {
        transform: none;
      }
    }
  </style>
</MainLayout>
