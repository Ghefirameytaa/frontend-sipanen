---
import MainLayout from '../layouts/MainLayout.astro';
import CatatanPanel from '../components/CatatanPanel.astro';
import DataSourceBadge from '../components/DataSourceBadge.astro';
import DataState from '../components/DataState.astro';
import ForecastChart from '../components/ForecastChart.astro';
import Ikon from '../components/Ikon.astro';
import PriceTable from '../components/PriceTable.astro';
import PilihanKomoditas from '../components/PilihanKomoditas.astro';
import TrenHarga from '../components/TrenHarga.astro';
import { getCommodities, getLatestPrices, getPriceHistory, getPredictions, rupiah, tanggalPanjang } from '../lib/api';
import { wilayahAktif } from '../lib/wilayah';

const wilayah = await wilayahAktif();
const bagianDiminta = Astro.url.searchParams.get('bagian');
const bagian = bagianDiminta === 'riwayat' ? 'riwayat' : 'terkini';

function tanggalValid(nilai: string | null): nilai is string {
  return nilai !== null && /^\d{4}-\d{2}-\d{2}$/.test(nilai);
}

function tanggalLalu(hari: number): string {
  const tanggal = new Date();
  tanggal.setDate(tanggal.getDate() - hari);
  return tanggal.toISOString().slice(0, 10);
}

const hariIni = new Date().toISOString().slice(0, 10);
const dari = tanggalValid(Astro.url.searchParams.get('dari'))
  ? Astro.url.searchParams.get('dari')!
  : tanggalLalu(30);
const sampai = tanggalValid(Astro.url.searchParams.get('sampai'))
  ? Astro.url.searchParams.get('sampai')!
  : hariIni;

const idKomoditasDiminta = Number(Astro.url.searchParams.get('komoditas'));
const idKomoditas = Number.isInteger(idKomoditasDiminta) && idKomoditasDiminta > 0
  ? idKomoditasDiminta
  : undefined;
const hariKurva = 7;

const [hasilHarga, hasilRiwayat, hasilPrediksi, hasilKomoditas] = wilayah.ok
  ? await Promise.all([
      bagian === 'terkini' ? getLatestPrices(wilayah.data.id) : null,
      bagian === 'riwayat'
        ? getPriceHistory({ commodityId: idKomoditas, from: dari, to: sampai })
        : bagian === 'terkini'
          ? getPriceHistory({ commodityId: idKomoditas ?? 1, from: tanggalLalu(365), to: hariIni })
          : null,
      bagian === 'terkini'
        ? getPredictions({ regionId: wilayah.data.id, historyDays: hariKurva })
        : null,
      getCommodities(wilayah.data.id),
    ])
  : [null, null, null, null];

const harga = hasilHarga?.ok ? hasilHarga.data : [];
const riwayat = hasilRiwayat?.ok ? hasilRiwayat.data : [];
// Respons API dapat memuat titik kosong setelah perubahan format data.
// Buang titik tanpa tanggal sebelum komponen grafik dan kartu membaca `date`.
const semuaPrediksi = hasilPrediksi?.ok
  ? (Array.isArray(hasilPrediksi.data) ? hasilPrediksi.data : [])
      .filter((seri) => seri && Array.isArray(seri.forecast))
      .map((seri) => ({
        ...seri,
        history: Array.isArray(seri.history) ? seri.history.filter((titik) => titik && typeof titik.date === 'string') : [],
        forecast: seri.forecast.filter((titik) => titik && typeof titik.date === 'string'),
      }))
  : [];
const komoditas = hasilKomoditas?.ok ? hasilKomoditas.data : [];
const catatanHarga = hasilHarga?.ok ? hasilHarga.meta.notes ?? [] : [];
const catatanPrediksi = hasilPrediksi?.ok ? hasilPrediksi.meta.notes ?? [] : [];

const daftarKomoditasPrediksi = komoditas.map((item) => ({ id: item.id, name: item.name }));

const komoditasDipilihId = idKomoditas ?? 1;
const hargaAwalPrediksi = harga.find((item) => item.commodity_id === komoditasDipilihId) ?? null;
const komoditasDipilihInfo = daftarKomoditasPrediksi.find((k) => k.id === komoditasDipilihId) ?? {
  id: komoditasDipilihId,
  name: 'Komoditas',
  variety: '',
  siap: false,
};
const panelPrediksi = daftarKomoditasPrediksi.map((item) => {
  const seri = semuaPrediksi.find((data) => data.commodity_id === item.id);
  const forecast = seri?.forecast ?? [];
  const hariKerja = forecast.filter((titik) => {
    const hari = new Date(`${titik.date}T00:00:00Z`).getUTCDay();
    return hari >= 1 && hari <= 5;
  }).slice(0, 5).map((titik) => ({
    ...titik,
    namaHari: titik.day_name || (titik.date ? ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'][new Date(titik.date).getUTCDay()] : 'Hari'),
    curah: titik.curah_hujan_mm ?? 0,
    peluang: titik.peluang_hujan ?? 0,
    kondisi: titik.kondisi_cuaca || 'Normal',
    pasar: titik.klasifikasi_pasar || 'Stabil',
    catatan: titik.catatan_cuaca || '',
  }));
  const totalHujan = hariKerja.reduce((total, titik) => total + titik.curah, 0);
  const rataHujan = hariKerja.length ? totalHujan / hariKerja.length : 0;
  const seriGrafikAktif = seri ? {
    ...seri,
    history: seri.history.slice(-hariKurva),
    forecast: forecast.slice(0, hariKurva),
  } : null;
  return { item, seri, forecast, hariKerja, totalHujan, rataHujan, seriGrafikAktif };
});
function jenisData(kind: string): 'aktual' | 'simulasi' | 'tidak_diketahui' {
  if (kind === 'aktual') return 'aktual';
  if (kind === 'simulasi') return 'simulasi';
  return 'tidak_diketahui';
}

function warnaKlasifikasi(teks?: string) {
  if (!teks) return 'border-stone-200 bg-stone-50 text-stone-700';
  if (teks.includes('Normal') || teks.includes('Stabil')) {
    return 'border-emerald-200 bg-emerald-50 text-emerald-800';
  }
  if (teks.includes('Waspada')) {
    return 'border-amber-200 bg-amber-50 text-amber-800';
  }
  if (teks.includes('Rawan')) {
    return 'border-rose-200 bg-rose-50 text-rose-800';
  }
  return 'border-stone-200 bg-stone-50 text-stone-700';
}
---

<MainLayout
  title="Harga"
  description="Harga Komoditas terkini, histori pasar, prediksi harga, dan saran tanam untuk Desa Blederan."
>
  <div class="space-y-10">
    <header data-page-hero class="banner-harga relative isolate overflow-hidden rounded-panel bg-[#125112] px-4 py-6 text-white shadow-lg sm:px-9 sm:py-10">
      <img src="/images/harga-pasar.jpg" alt="Tanaman cabai di lahan pertanian" class="absolute inset-0 z-0 h-full w-full object-cover opacity-90" width="1024" height="461" />
      <div data-page-hero-overlay class="hero-photo-overlay absolute inset-0 z-10" aria-hidden="true"></div>
      <div class="relative z-20 flex flex-wrap items-end justify-between gap-5">
        <div class="relative max-w-3xl">
          <p data-page-hero-badge class="mb-3 inline-flex max-w-full items-center gap-1.5 rounded-full bg-[#EAF2CF] px-2.5 py-1.5 text-[10px] font-bold uppercase leading-tight tracking-[0.04em] text-[#263238] sm:gap-2 sm:px-3 sm:text-sm sm:tracking-wide">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#125112]" aria-hidden="true"></span>
            <span class="min-w-0">Pasar & perencanaan</span>
          </p>
          <h1 class="font-display text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">Harga komoditas</h1>
          <p class="mt-3 text-base text-green-50 sm:text-lg">
          Bandingkan catatan harga, lihat arah perkiraan, lalu rencanakan<br class="hidden sm:inline" /> waktu tanam dengan informasi yang tersedia.
          </p>
        </div>
        {wilayah.ok && (
          <a
            href="https://maps.app.goo.gl/VL6iMscwiEDm4pkd9"
            target="_blank"
            rel="noreferrer"
            class="group relative inline-flex min-h-9 max-w-full items-center gap-1 rounded-full border border-[#F8F9FA] bg-[#4D4D4D]/25 px-2 py-1 text-xs font-semibold leading-snug text-[#FFFFFF] shadow-[0_2px_8px_rgba(38,50,56,0.3)] transition-all duration-200 hover:-translate-y-0.5 hover:border-white hover:bg-[#4D4D4D]/40 hover:shadow-[0_0_14px_rgba(255,255,255,0.2)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFFFFF] active:translate-y-0 active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none sm:px-2.5"
            aria-label={`Buka lokasi ${wilayah.data.name}, ${wilayah.data.regency} di Google Maps`}
          >
            <Ikon nama="beranda" ukuran={14} kelas="block shrink-0 transition-transform duration-200 group-hover:scale-110 motion-reduce:transition-none" />
            <span class="inline-flex min-w-0 items-center leading-none break-words">{wilayah.data.name}, {wilayah.data.regency}</span>
          </a>
        )}
      </div>
    </header>

    {!wilayah.ok && (
      <DataState
        jenis={wilayah.error.code === 'tidak_terhubung' ? 'galat' : 'kosong'}
        pesan={wilayah.error.message}
        saran="Pastikan server data menyala, lalu muat ulang halaman ini."
      />
    )}

    {wilayah.ok && bagian === 'terkini' && (
      <div class="space-y-10">
        <section aria-labelledby="judul-harga-terkini" class="space-y-8 px-1.5 sm:px-0">
          <!-- Header Bar -->
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div class="mb-2 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#D5E3A8] bg-[#EAF2CF] px-2.5 py-1 text-xs font-bold text-[#263238]">
                  Pasar Wonosobo
                </span>
                <span class="basis-full text-xs leading-relaxed text-tinta-kedua font-medium sm:basis-auto sm:leading-normal">
                  Pembaruan terjadwal: 06.00 WIB
                </span>
              </div>
              <h2 id="judul-harga-terkini" class="font-display text-2xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-3xl">
                Harga Pasar Hari Ini
              </h2>
              <p class="mt-2 text-xs leading-relaxed text-tinta-kedua sm:text-sm sm:leading-normal">
                Harga hortikultura yang tersedia dari Pasar Induk Kabupaten Wonosobo.
              </p>
            </div>
          </div>

          {!hasilHarga || !hasilHarga.ok ? (
            <DataState
              jenis={hasilHarga?.ok === false && hasilHarga.error.code === 'tidak_terhubung' ? 'galat' : 'kosong'}
              pesan={hasilHarga && !hasilHarga.ok ? hasilHarga.error.message : 'Harga belum dapat diambil.'}
              saran="Periksa sambungan ke server data, lalu coba lagi."
            />
          ) : harga.length === 0 ? (
            <DataState
              jenis="kosong"
              judul="Belum ada catatan harga"
              pesan="Belum ada harga untuk ditampilkan pada wilayah ini."
              saran="Database belum berisi harga. Jalankan pipeline ml-pipeline/main_job.py setelah menyamakan konfigurasi database dengan backend-go/.env."
            />
          ) : (
            <>
              <PriceTable harga={harga} />
              {catatanHarga.length > 0 ? <CatatanPanel catatan={catatanHarga} /> : null}
            </>
          )}
        </section>
      </div>
    )}

    {wilayah.ok && bagian === 'riwayat' && (
      <section aria-labelledby="judul-riwayat-lengkap" class="space-y-7">
        <div>
          <p class="mb-1 text-sm font-bold uppercase tracking-wider text-sipanen-800">Pergerakan pasar</p>
          <h2 id="judul-riwayat-lengkap" class="font-display text-2xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-3xl">Riwayat harga</h2>
          <p class="mt-2 text-tinta-kedua">Pilih komoditas dan rentang tanggal untuk menelusuri catatan pasar.</p>
        </div>
        <form action="/harga" method="get" class="grid gap-5 rounded-card border border-kertas-garis bg-white p-4 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto] lg:items-end">
          <input type="hidden" name="bagian" value="riwayat" />
          <label class="grid gap-1 font-semibold" for="komoditas-riwayat">
            Komoditas
            <select id="komoditas-riwayat" name="komoditas" class="min-h-sentuh rounded-control border border-kertas-garis bg-white px-3 font-normal">
              <option value="">Semua Komoditas</option>
              {komoditas.map((item) => <option value={item.id} selected={item.id === idKomoditas}>{item.name}</option>)}
            </select>
          </label>
          <label class="grid gap-1 font-semibold" for="riwayat-dari">
            Dari tanggal
            <input id="riwayat-dari" type="date" name="dari" value={dari} class="min-h-sentuh rounded-control border border-kertas-garis bg-white px-3 font-normal" />
          </label>
          <label class="grid gap-1 font-semibold" for="riwayat-sampai">
            Sampai tanggal
            <input id="riwayat-sampai" type="date" name="sampai" value={sampai} max={hariIni} class="min-h-sentuh rounded-control border border-kertas-garis bg-white px-3 font-normal" />
          </label>
          <button type="submit" class="inline-flex min-h-sentuh items-center justify-center gap-2 rounded-control border border-[#B9D0AD] bg-[#DCE9D2] px-5 font-bold text-[#125112] transition-colors hover:bg-[#C5D9BC]">
            <Ikon nama="banding" ukuran={20} />
            Terapkan filter
          </button>
        </form>
        {!hasilRiwayat || !hasilRiwayat.ok ? (
          <DataState
            jenis={hasilRiwayat?.ok === false && hasilRiwayat.error.code === 'tidak_terhubung' ? 'galat' : 'kosong'}
            pesan={hasilRiwayat && !hasilRiwayat.ok ? hasilRiwayat.error.message : 'Riwayat harga belum tersedia.'}
            saran="Coba ubah komoditas atau rentang tanggal."
          />
        ) : riwayat.length === 0 ? (
          <DataState jenis="kosong" judul="Tidak ada catatan pada rentang ini" pesan="Belum ada riwayat harga untuk filter yang dipilih." />
        ) : (
          <div class="overflow-x-auto rounded-card border border-kertas-garis bg-white">
            <table class="w-full min-w-[38rem] border-collapse text-left">
              <caption class="sr-only">Riwayat harga komoditas dan pasar</caption>
              <thead class="bg-sipanen-50">
                <tr>
                  <th scope="col" class="px-4 py-3">Komoditas</th>
                  <th scope="col" class="px-4 py-3">Pasar</th>
                  <th scope="col" class="px-4 py-3">Tanggal</th>
                  <th scope="col" class="px-4 py-3 text-left">Harga</th>
                  <th scope="col" class="px-4 py-3">Asal data</th>
                </tr>
              </thead>
              <tbody>
                {riwayat.map((item) => (
                  <tr class="border-t border-kertas-garis">
                    <th scope="row" class="px-4 py-3 font-semibold">{item.commodity}</th>
                    <td class="px-4 py-3">{item.market}</td>
                    <td class="px-4 py-3 whitespace-nowrap">{tanggalPanjang(item.date)}</td>
                    <td class="px-4 py-3 text-left font-bold tabular-nums whitespace-nowrap">{rupiah(item.price)}</td>
                    <td class="px-4 py-3"><DataSourceBadge kind={jenisData(item.data_kind)} ukuran="kecil" /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )}

    {wilayah.ok && bagian === 'terkini' && (
      <section id="tren-prediksi" aria-labelledby="judul-prediksi" class="scroll-mt-24 space-y-8 sm:scroll-mt-28">
        <header class="max-w-3xl">
          <p class="mb-1 text-sm font-bold uppercase tracking-wider text-sipanen-800">Pantauan harga</p>
          <h2 id="judul-prediksi" class="font-display text-2xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-3xl">Tren dan Prediksi Harga Komoditas</h2>
        </header>
        {!hasilPrediksi || !hasilPrediksi.ok ? (
          <div class="space-y-6">
            <DataState
              jenis={hasilPrediksi?.ok === false && hasilPrediksi.error.code === 'tidak_terhubung' ? 'galat' : 'kosong'}
              pesan={hasilPrediksi && !hasilPrediksi.ok ? hasilPrediksi.error.message : 'Prediksi belum dapat diambil.'}
              saran="Tren harga aktual tetap dapat dilihat bila catatan harga tersedia."
            />
            <PilihanKomoditas items={daftarKomoditasPrediksi} selectedId={komoditasDipilihId} />
            <TrenHarga komoditas={komoditasDipilihInfo.name} riwayat={riwayat} hargaTerkini={hargaAwalPrediksi} />
          </div>
        ) : semuaPrediksi.length === 0 ? (
          <div class="space-y-6">
              <DataState
                jenis="kosong"
                judul="Data harga dan prediksi belum tersedia"
                pesan="Backend berjalan, tetapi database belum berisi riwayat harga atau hasil prediksi."
                saran="Jalankan pipeline ml-pipeline/main_job.py setelah menyamakan konfigurasi database dengan backend-go/.env."
              />
              <PilihanKomoditas items={daftarKomoditasPrediksi} selectedId={komoditasDipilihId} />
              <TrenHarga komoditas={komoditasDipilihInfo.name} riwayat={riwayat} hargaTerkini={hargaAwalPrediksi} />
          </div>
        ) : (
          <div class="space-y-8">
            <PilihanKomoditas items={daftarKomoditasPrediksi} selectedId={komoditasDipilihId} />

            <div class="space-y-10">
              {panelPrediksi.map(({ item, seri, forecast, hariKerja, totalHujan, rataHujan, seriGrafikAktif }) => (
                  <div data-panel-prediksi={item.id} hidden={item.id !== komoditasDipilihId}>
                    {seri && forecast.length > 0 && seriGrafikAktif ? (
                      <div class="space-y-10">
                        <ForecastChart
                          seri={seriGrafikAktif}
                          hariKerja={hariKerja}
                        />
                        <section class="rounded-card border border-kertas-garis bg-white p-4 shadow-sm sm:p-6" aria-labelledby={`judul-prakiraan-${item.id}`}>
                          <header class="flex flex-col gap-4 border-b border-kertas-garis pb-4 lg:flex-row lg:items-start lg:justify-between">
                            <div class="min-w-0">
                              <span class="inline-flex items-center rounded-full bg-[#EAF2CF] px-3 py-1 text-xs font-bold text-[#263238]">5 Hari Kerja</span>
                              <h3 id={`judul-prakiraan-${item.id}`} class="mt-2 font-display text-xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-2xl">Harga dan cuaca harian</h3>
                              <p class="mt-1 max-w-2xl text-sm leading-relaxed text-tinta-kedua">Lihat perkiraan harga, kondisi cuaca, dan peluang hujan untuk setiap hari.</p>
                            </div>
                            {seri.weather_summary && (
                              <div class="flex shrink-0 items-center gap-3 rounded-xl border border-[#64902E] bg-[#E6EFE6] px-3 py-2.5 text-[#263238] dark:border-[#64902E] dark:bg-[#263238] dark:text-[#F8F9FA] sm:px-4">
                                <span class="rounded-lg bg-[#C0F283] p-2 text-[#125112] dark:bg-[#64902E] dark:text-[#F8F9FA]" aria-hidden="true"><Ikon nama="hujan" ukuran={18} /></span>
                                <div>
                                  <p class="text-xs font-semibold text-[#125112] dark:text-[#C0F283]">Hujan dalam 5 hari</p>
                                  <p class="text-sm font-bold">{totalHujan} mm total<span class="font-normal text-[#263238] dark:text-[#E2E7EA]"> · {rataHujan.toFixed(1)} mm/hari</span></p>
                                </div>
                              </div>
                            )}
                          </header>
                          {seri.weather_summary?.rekomendasi_petani && (
                            <div class="mt-4 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50/80 p-3 text-sm leading-relaxed text-amber-950 sm:p-4">
                              <span class="mt-0.5 shrink-0 rounded-lg bg-amber-100 p-1.5 text-amber-800" aria-hidden="true"><Ikon nama="peringatan" ukuran={18} /></span>
                              <div class="min-w-0">
                                <p class="font-bold text-amber-900">Catatan cuaca dan pasokan � {seri.weather_summary.status_umum}</p>
                                <p class="mt-1 text-amber-900/90">{seri.weather_summary.rekomendasi_petani}</p>
                              </div>
                            </div>
                          )}
                          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
                            {hariKerja.map((f) => (
                                <article class="flex min-w-0 flex-col gap-3 rounded-xl border border-kertas-garis bg-white p-3 shadow-sm sm:p-4">
                                  <header class="flex items-center justify-between gap-2 border-b border-kertas-garis pb-2.5">
                                    <span class="rounded-lg bg-[#125112] px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-white">{f.namaHari}</span>
                                    <time datetime={f.date} class="text-xs font-medium text-tinta-kedua">{tanggalPanjang(f.date).replace(/ \d{4}$/, '')}</time>
                                  </header>
                                  <span class:list={['inline-flex w-fit max-w-full rounded-full border px-2.5 py-1 text-xs font-semibold leading-tight', warnaKlasifikasi(f.pasar)]}>{f.pasar}</span>
                                  <div>
                                    <p class="text-xs font-semibold text-tinta-kedua">Rentang harga per hari</p>
                                    <p class="mt-0.5 whitespace-nowrap font-display text-base font-extrabold leading-tight tabular-nums text-sipanen-950 sm:text-sm xl:text-base">{rupiah(f.lower)} – {rupiah(f.upper)}</p>
                                    <p class="text-xs text-tinta-redup">per {seri.unit}</p>
                                  </div>
                                  <div class="mt-auto rounded-xl border border-sky-100 bg-sky-50/70 p-3 text-blue-950">
                                    <div class="flex items-center justify-between gap-2">
                                      <span class="inline-flex items-center gap-1.5 text-sm font-bold"><Ikon nama="hujan" ukuran={16} kelas="shrink-0 text-blue-700" />{f.curah} mm</span>
                                      <span class="rounded-full bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-900">Peluang {f.peluang}%</span>
                                    </div>
                                    <p class="mt-1.5 text-sm font-medium">{f.kondisi}</p>
                                    {f.catatan && <p class="mt-1 text-xs leading-relaxed text-blue-900/80">{f.catatan}</p>}
                                  </div>
                                </article>
                            ))}
                          </div>
                        </section>
                      </div>
                    ) : (
                      <div class="rounded-card border-2 border-dashed border-amber-300 bg-amber-50/70 p-8 text-center sm:p-12">
                        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 text-amber-800 shadow-sm"><Ikon nama="jam" ukuran={32} /></div>
                        <span class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-amber-200/90 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-950">Tahap Pelatihan Data � Segera Hadir</span>
                        <h3 class="mt-3 font-display text-2xl font-bold leading-tight tracking-tight text-amber-950 sm:text-3xl">Model Prediksi {item.name} Sedang Disiapkan</h3>
                        <p class="mx-auto mt-2.5 max-w-xl text-sm leading-relaxed text-amber-900/90 sm:text-base">Model AI prediksi harga untuk komoditas <strong>{item.name}</strong> sedang dalam proses sinkronisasi.</p>
                      </div>
                    )}
                  </div>
            ))}
            </div>
            {catatanPrediksi.length > 0 ? <CatatanPanel catatan={catatanPrediksi} /> : null}
          </div>
        )}
      </section>
    )}
  </div>
</MainLayout>
