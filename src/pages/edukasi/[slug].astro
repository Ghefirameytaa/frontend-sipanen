---
/**
 * /edukasi/[slug] — satu modul edukasi.
 *
 * Modul tidak ditulis di dalam berkas ini, melainkan diambil dari backend
 * supaya tim KKN dapat memperbaiki isinya tanpa mengubah program. Karena itu
 * halaman ini hanya mengurus tampilan: judul, bagian-bagian, intisari,
 * peringatan, dan sumber.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import DataState from '../../components/DataState.astro';
import { getEducationModule, type EducationModule } from '../../lib/api';

const { slug } = Astro.params;

const URL_ARTIKEL_ASLI = 'https://distankan.bulelengkab.go.id/informasi/detail/artikel/42_pemupukan-tanaman-cabai-dalam-polybag';
const GAMBAR_ARTIKEL = 'https://distankan.bulelengkab.go.id/uploads/konten/42_pemupukan-tanaman-cabai-dalam-polybag_2026-02-28-15-15-21.jpg';
const GAMBAR_KATEGORI: Record<string, string> = {
  pupuk: 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1400&q=80',
  nutrisi: 'https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=1400&q=80',
  perawatan: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1400&q=80',
  air: 'https://images.unsplash.com/photo-1530053969600-caed2596d242?auto=format&fit=crop&w=1400&q=80',
};
const isPolybag = slug === 'pemupukan-cabai-polybag';
const hasil = isPolybag ? null : await getEducationModule(slug ?? '');
const artikelPolybag: EducationModule = {
  slug: 'pemupukan-cabai-polybag',
  title: 'Pemupukan Tanaman Cabai dalam Polybag',
  summary: 'Panduan pemupukan cabai polybag dari persiapan media hingga fase berbuah.',
  category: 'pupuk',
  reading_minutes: 0,
  sort_order: 999,
  sections: [
    {
      heading: 'Siapkan media dan pupuk dasar',
      body: [
        'Gunakan polybag berukuran 30–40 cm. Campurkan tanah gembur, pupuk kandang matang atau kompos, serta sekam bakar atau cocopeat dengan perbandingan 1:1:1.',
        'Untuk setiap polybag, tambahkan 0,5–1 kg pupuk kandang dan 10–15 gram NPK majemuk (15-15-15 atau 16-16-16). Dolomit 10–20 gram digunakan bila pH tanah di bawah 6. Campur merata dan diamkan 5–7 hari sebelum tanam.',
      ],
    },
    {
      heading: 'Sesuaikan pupuk dengan fase tanaman',
      body: [
        'Fase vegetatif (0–30 HST): gunakan NPK seimbang 16-16-16 sebanyak 5 gram per tanaman setiap 7–10 hari. Pupuk bisa ditabur melingkar sekitar 5 cm dari batang lalu ditutup tipis tanah, atau dikocor dengan melarutkan 5 gram dalam 1 liter air.',
        'Fase berbunga (30–45 HST): kebutuhan fosfor dan kalium meningkat. Gunakan pupuk dengan kandungan P dan K lebih tinggi, misalnya 12-12-17 atau 13-13-21, sebanyak 5 gram per tanaman setiap 7–10 hari.',
        'Fase berbuah (45 HST ke atas): kebutuhan kalium lebih dominan. Berikan pupuk tinggi kalium sebanyak 5 gram per tanaman setiap 7 hari. Kalsium 1–2 gram per tanaman setiap 2 minggu dapat ditambahkan untuk membantu mencegah busuk ujung buah.',
      ],
    },
    {
      heading: 'Berikan sedikit demi sedikit dan rutin',
      body: [
        'Penyiraman sebelum dan sesudah pemupukan dianjurkan agar akar tidak stres dan unsur hara terserap. Dosis kecil tetapi rutin membantu menghindari penumpukan garam yang dapat merusak akar.',
      ],
    },
  ],
  key_points: [],
  source: 'Vani Silvana, S.P., POPT Ahli Pertama pada Dinas Pertanian, Ketahanan Pangan dan Perikanan Kabupaten Buleleng. Pustaka: Direktorat Jenderal Hortikultura (2020) dan Kementerian Pertanian RI (2018).',
};

const modul = isPolybag ? artikelPolybag : hasil?.ok ? hasil.data : null;
const error = hasil && !hasil.ok ? hasil.error : null;
const gambar = isPolybag ? GAMBAR_ARTIKEL : modul ? GAMBAR_KATEGORI[modul.category] : undefined;

// Modul yang tidak ada harus menjawab 404, bukan 200 berisi pesan. Tanpa ini,
// mesin pencari dan pemeriksa tautan menganggap alamat yang salah sebagai
// halaman yang sah.
if (!modul) {
  Astro.response.status = 404;
}

const KATEGORI: Record<string, string> = {
  pupuk: 'Pupuk',
  nutrisi: 'Nutrisi tanaman',
  perawatan: 'Perawatan',
  air: 'Air dan penyiraman',
};
const kategori = modul ? (KATEGORI[modul.category] ?? null) : null;
---

<MainLayout title={modul ? modul.title : 'Modul Edukasi'} description={modul?.summary}>
  {
    !modul ? (
      <DataState
        jenis={error?.code === 'tidak_terhubung' ? 'galat' : 'kosong'}
        judul="Modul tidak ditemukan"
        pesan={error?.message ?? 'Modul yang Anda cari tidak ada atau sudah diganti.'}
        saran="Kembali ke daftar panduan untuk memilih modul yang tersedia."
        tautan={{ href: '/edukasi', label: 'Lihat semua panduan' }}
      />
    ) : (
      <div class="mx-auto w-full max-w-[90rem] space-y-1">
        <nav aria-label="Navigasi halaman">
          <a
            href="/edukasi"
            class="inline-flex min-h-sentuh items-center rounded-full px-3 text-sm font-medium text-tinta-kedua transition-colors hover:text-[#125112] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sipanen-700"
          >
            &larr; Semua panduan
          </a>
        </nav>

        <article class="space-y-6 rounded-card bg-white p-4 font-sans shadow-sm sm:space-y-8 sm:p-7">
        <header>
          {
            kategori && (
              <p class="font-semibold text-tinta-redup">{kategori}</p>
            )
          }
          <h1 class="font-display mt-1 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">{modul.title}</h1>
          <p class="mt-3 text-base leading-relaxed text-tinta-kedua">{modul.summary}</p>
          {isPolybag && <p class="mt-3 text-sm text-tinta-redup">Oleh Vani Silvana, S.P. · POPT Ahli Pertama, Dinas Pertanian Kabupaten Buleleng</p>}
        </header>

        {gambar && (
          <figure class="overflow-hidden rounded-xl">
            <img src={gambar} alt={isPolybag ? 'Tanaman cabai yang dibudidayakan dalam polybag' : `Ilustrasi artikel kategori ${kategori ?? 'budidaya tanaman'}`} width="1400" height="800" loading="lazy" class="aspect-[16/8] w-full object-cover" />
            <figcaption class="mt-2 text-sm text-tinta-redup">{isPolybag ? 'Foto dari Dinas Pertanian, Ketahanan Pangan dan Perikanan Kabupaten Buleleng.' : `Ilustrasi kategori ${kategori ?? 'budidaya tanaman'}.`}</figcaption>
          </figure>
        )}

        <!-- Intisari ditaruh paling atas supaya pembaca yang tidak menyelesaikan
             seluruh modul tetap membawa pulang hal yang paling penting. -->
        {
          modul.key_points.length > 0 && (
            <aside class="pt-2">
              <h2 class="mb-3 text-[15px] font-normal leading-8 text-tinta-kedua">Intisari</h2>
              <ul class="list-disc space-y-3 pl-5 text-[15px] leading-8 text-tinta-kedua">
                {modul.key_points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </aside>
          )
        }

        {
          modul.sections.map((s) => (
            <section class="max-w-5xl space-y-2">
              <h2 class="text-[15px] font-normal leading-8 text-tinta-kedua">{s.heading}</h2>
              {s.body.map((p) => (
                <p class="text-[15px] leading-8 text-tinta-kedua">{p}</p>
              ))}
            </section>
          ))
        }

        {
          modul.caution && (
            <aside class="max-w-5xl space-y-3">
              <h2 class="text-[15px] font-normal leading-8 text-amber-900">Perlu diperhatikan</h2>
              <p class="text-[15px] leading-8 text-amber-900">{modul.caution}</p>
            </aside>
          )
        }

        <!-- Sumber wajib disebut: klaim tanpa asal tidak dapat diperiksa. -->
        <footer class="pt-2 space-y-4">
          {isPolybag ? (
            <p class="text-sm leading-relaxed text-tinta-redup">
              Sumber dan bacaan lengkap:{' '}
              <a href={URL_ARTIKEL_ASLI} target="_blank" rel="noopener noreferrer" class="font-semibold text-sipanen-800 underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
                Pemupukan Tanaman Cabai dalam Polybag — Dinas Pertanian Buleleng
              </a>
              <span class="mt-2 block">Pustaka yang dicantumkan sumber: Direktorat Jenderal Hortikultura (2020) dan Kementerian Pertanian RI (2018).</span>
            </p>
          ) : (
          <p class="max-w-5xl text-sm leading-relaxed text-tinta-redup">
            <strong class="text-tinta-utama">Sumber: </strong>{modul.source}
          </p>
          )}

        </footer>
        </article>
      </div>
    )
  }
</MainLayout>
