---

/**

 * Beranda — pintu masuk ke layanan dan informasi pertanian SiPanen.

 */

import MainLayout from '../layouts/MainLayout.astro';

import DataState from '../components/DataState.astro';

import Ikon from '../components/Ikon.astro';

import IkonArahHarga from '../components/IkonArahHarga.astro';

import Lipatan from '../components/Lipatan.astro';

import { getLatestPrices, rupiah, persen } from '../lib/api';

import { wilayahAktif } from '../lib/wilayah';



const wilayah = await wilayahAktif();



// Kedua permintaan dijalankan bersamaan; keduanya tidak saling bergantung.

const hasilHarga = wilayah.ok ? await getLatestPrices(wilayah.data.id) : null;



const harga = hasilHarga?.ok ? hasilHarga.data : [];

const ilustrasiKomoditas: Record<string, string> = {
  'cabai-keriting': '/komoditas/cabai-merah-keriting.png',
  'cabai-merah-keriting': '/komoditas/cabai-merah-keriting.png',
  'cabai-rawit-merah': '/komoditas/cabai-rawit-merah.png',
  'cabai-rawit-hijau': '/komoditas/cabai-rawit-hijau.png',
  tomat: '/komoditas/tomat-kalender.png',
  'tomat-besar': '/komoditas/tomat-kalender.png',
  'tomat-kecil': '/komoditas/tomat-kalender.png',
};



const fitur = [

  {

    href: '/harga?bagian=prediksi#tren-prediksi',

    ikon: 'growth',

    judul: 'Prediksi Harga Pasar',

    isi: 'Perkiraan 7 hari ke depan, beserta rentangnya.',

    utama: true,

  },

  {

    href: '/kalender',

    ikon: 'kalender',

    judul: 'Kalender Masa Tanam',

    isi: 'Jadwal persiapan sampai panen, bulan demi bulan.',

    utama: false,

  },

  {

    href: '/harga',

    ikon: 'harga',

    judul: 'Harga Hari Ini',

    isi: 'Harga terkini tiap komoditas di Kab. Wonosobo.',

    utama: false,

  },

  {

    href: '/edukasi',

    ikon: 'panduan',

    judul: 'Panduan Pupuk & Nutrisi',

    isi: 'Cara memupuk dan mengenali tanaman kekurangan hara.',

    utama: false,

  },

];

---



<MainLayout title="Beranda">

  {

    !wilayah.ok ? (

      <div class="beranda-inter space-y-6 font-sans">

        {/* Judul tetap ditampilkan walau data gagal dimuat, supaya halaman

            tidak pernah kehilangan penanda utamanya — penting bagi pengguna

            pembaca layar, yang menavigasi berdasarkan judul. */}

        <h1 class="font-display text-xl font-extrabold leading-tight tracking-tight text-tinta-utama sm:text-3xl lg:text-4xl">Informasi pertanian untuk petani</h1>

        <DataState

          jenis={wilayah.error.code === 'tidak_terhubung' ? 'galat' : 'kosong'}

          pesan={wilayah.error.message}

          saran="Pastikan server data menyala, lalu muat ulang halaman ini."

        />

      </div>

    ) : (

      <div class="beranda-inter space-y-6 font-sans sm:space-y-8">

        <section class="relative isolate min-h-[30rem] overflow-hidden rounded-panel bg-[#125112] text-white shadow-lg" aria-labelledby="judul-utama">

          <div class="relative z-10 mx-auto grid min-h-[30rem] w-full max-w-[90rem] items-center gap-8 px-5 py-8 sm:px-10 sm:py-10 lg:px-14">

            <div class="flex flex-col items-start text-left">

            <a

              href="#judul-layanan"

              class="group relative -top-2 mb-5 inline-flex w-fit max-w-full items-center justify-center gap-1.5 rounded-full bg-[#EAF2CF] px-2.5 py-1.5 text-center text-xs font-bold uppercase leading-tight tracking-[0.04em] text-tinta-utama shadow-[0_2px_8px_rgba(38,50,56,0.18)] transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.02] hover:bg-[#CFEB73] hover:shadow-[0_4px_12px_rgba(38,50,56,0.24)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFFFFF] active:translate-y-0 active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none dark:bg-[#ABBED1] dark:text-tinta-utama dark:hover:bg-[#89939E] sm:gap-2 sm:px-3 sm:text-sm sm:tracking-wide lg:mb-3"

              title="Lihat layanan SiPanen"

            >

              <span class="min-w-0">Informasi Pertanian {wilayah.data.name}</span>

            </a>

            <h1 id="judul-utama" class="font-display max-w-none text-xl font-extrabold leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl xl:whitespace-nowrap">

              Sistem Informasi Pertanian Desa Blederan

            </h1>

            <p class="mt-5 max-w-3xl text-base leading-relaxed text-white sm:text-lg lg:mt-5 lg:text-xl">

              Pantau harga dan cuaca, rencanakan waktu tanam, kenali gejala tanaman, dan pelajari budidaya di {wilayah.data.name}.

            </p>

            <div class="mt-6 flex w-full max-w-4xl flex-row flex-wrap items-center justify-start gap-2 sm:mt-8 sm:w-auto sm:gap-3">

              <a href="/harga" class="inline-flex min-h-sentuh w-fit items-center justify-center gap-1 whitespace-nowrap rounded-full border border-[#B9D0AD] bg-[#DCE9D2] px-3 text-center text-sm font-bold leading-tight text-sipanen-700 shadow-[0_4px_14px_rgba(38,50,56,0.2)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#C5D9BC] hover:shadow-[0_8px_22px_rgba(38,50,56,0.32)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFFFFF] active:translate-y-0 active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none sm:w-auto sm:flex-none sm:gap-2 sm:px-5 sm:text-base sm:leading-normal sm:min-w-[12.5rem] dark:shadow-[0_4px_14px_rgba(248,249,250,0.12)] dark:hover:shadow-[0_8px_22px_rgba(248,249,250,0.2)]">

                <Ikon nama="harga" ukuran={16} kelas="shrink-0 sm:h-[22px] sm:w-[22px]" inline />

                Cek harga hari ini

              </a>

              <a href="/kalender#saran-tanam" class="inline-flex min-h-sentuh w-fit items-center justify-center gap-1 whitespace-nowrap rounded-full border border-[#C7D2DF] bg-white px-3 text-center text-sm font-bold leading-tight text-[#344054] shadow-[0_4px_14px_rgba(38,50,56,0.2)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#C5D9BC] hover:shadow-[0_8px_22px_rgba(38,50,56,0.32)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFFFFF] active:translate-y-0 active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none sm:w-auto sm:flex-none sm:gap-2 sm:px-5 sm:text-base sm:leading-normal sm:min-w-[12.5rem] dark:shadow-[0_4px_14px_rgba(248,249,250,0.12)] dark:hover:shadow-[0_8px_22px_rgba(248,249,250,0.2)]">

                <Ikon nama="saran" ukuran={16} kelas="shrink-0 sm:h-[22px] sm:w-[22px]" inline />

                Lihat saran tanam

              </a>

            </div>

            <ul class="mt-5 flex w-fit max-w-full flex-wrap justify-start gap-2 text-xs leading-tight text-white sm:text-sm sm:leading-normal">

              <li>

                <a

                  href="https://maps.app.goo.gl/VL6iMscwiEDm4pkd9"

                  target="_blank"

                  rel="noreferrer"

                  class="group inline-flex min-h-10 w-fit max-w-full items-center gap-1.5 rounded-full border border-[#F8F9FA] bg-[#4D4D4D]/25 px-2.5 py-1.5 text-xs leading-tight text-white shadow-[0_2px_8px_rgba(38,50,56,0.3)] transition-all duration-200 hover:-translate-y-0.5 hover:border-white hover:bg-[#4D4D4D]/40 hover:shadow-[0_0_14px_rgba(255,255,255,0.2)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFFFFF] active:translate-y-0 active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none sm:gap-1.5 sm:px-3"

                  aria-label={`Buka lokasi ${wilayah.data.name}, ${wilayah.data.regency} di Google Maps`}

                >

                  <Ikon nama="beranda" ukuran={16} kelas="block shrink-0 transition-transform duration-200 group-hover:scale-110 motion-reduce:transition-none" />

                  <span class="inline-flex min-w-0 items-center whitespace-nowrap leading-none">{wilayah.data.name}, {wilayah.data.regency}</span>

                </a>

              </li>







            </ul>



          </div>

          <div class="absolute inset-0 -z-10">

            <img

              src="/tomat-beranda.png"

              alt=""

              aria-hidden="true"

              class="hero-background hero-background-tomato absolute inset-0 h-full w-full object-cover"

              width="1920"

              height="768"

              fetchpriority="high"

            />

            <img

              src="/cabai-merah-beranda.jpg"

              alt=""

              aria-hidden="true"

              class="hero-background hero-background-chili absolute inset-0 h-full w-full object-cover"

              width="1094"

              height="768"

              loading="eager"

              decoding="async"

            />

            <div class="absolute inset-0 bg-gradient-to-r from-black/5 via-transparent to-transparent" aria-hidden="true"></div>

          </div>

          </div>

        </section>







        <section aria-labelledby="judul-profil-desa" class="relative isolate py-5 sm:py-8">
          <div class="relative z-10 mx-auto max-w-[90rem]">
            <header class="mb-6 max-w-3xl sm:mb-8">
              <p class="mb-2 text-xs font-bold uppercase tracking-[0.14em] text-sipanen-800 sm:text-sm">Kenali wilayah</p>
              <h2 id="judul-profil-desa" class="font-display text-2xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-3xl">Mengenal Desa Blederan</h2>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-tinta-kedua sm:text-base">
                Blederan adalah desa pertanian di Kecamatan Mojotengah, Kabupaten Wonosobo, sekitar 7 km dari pusat kabupaten, yang terdiri dari Dusun Blederan dan Dusun Klesman.
              </p>
            </header>

            <article class="grid overflow-hidden rounded-2xl bg-white shadow-sm lg:grid-cols-2">
              <figure class="relative aspect-[16/9] overflow-hidden rounded-[10px] bg-[#EAF2CF]">
                <img src="/images/kampung-sayur/lahan-pertanian.jpg" alt="Ilustrasi lahan pertanian dengan barisan tanaman sayur" class="absolute inset-0 h-full w-full rounded-[10px] object-cover" width="1024" height="461" loading="lazy" />
              </figure>

              <div class="min-w-0 p-5 sm:p-7 lg:p-8">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-sipanen-800 sm:text-sm">Potensi unggulan</p>
                <h3 class="mt-2 font-display text-xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-2xl">Kampung Sayur Blederan</h3>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-tinta-kedua sm:text-base">
                  Budidaya sayuran di pekarangan warga berkembang menjadi tujuan belajar dan kunjungan edukasi sejak 2018.
                </p>

                <div class="mt-6 grid grid-cols-2 gap-4 border-y border-kertas-garis py-4 sm:mt-7 sm:gap-6 sm:py-5">
                  <div class="min-w-0">
                    <strong class="block font-display text-3xl font-extrabold leading-none tabular-nums text-sipanen-700 sm:text-4xl">22.673</strong>
                    <span class="mt-2 block text-sm leading-snug text-tinta-kedua">polybag tercatat</span>
                  </div>
                  <div class="min-w-0">
                    <strong class="block font-display text-3xl font-extrabold leading-none tabular-nums text-sipanen-700 sm:text-4xl">1.650</strong>
                    <span class="mt-2 block text-sm leading-snug text-tinta-kedua">pengunjung pada 2025</span>
                  </div>
                </div>

                <div class="mt-5 flex items-start gap-3 sm:mt-6">
                  <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#EAF2CF] text-sipanen-700" aria-hidden="true">
                    <Ikon nama="daun" ukuran={18} />
                  </span>
                  <div class="min-w-0">
                    <h4 class="font-display text-sm font-semibold text-tinta-utama sm:text-base">Pupuk organik cair buatan warga</h4>
                    <p class="mt-1 text-sm leading-relaxed text-tinta-kedua">Dibuat dari sisa sayuran, buah-buahan, dan limbah air tahu.</p>
                  </div>
                </div>
              </div>
            </article>

            <section class="mt-9 sm:mt-12" aria-labelledby="judul-potensi-desa">
              <header class="mb-4 sm:mb-6">
                <p class="mb-2 text-xs font-bold uppercase tracking-[0.14em] text-sipanen-800 sm:text-sm">Kehidupan dan sumber daya</p>
                <h3 id="judul-potensi-desa" class="font-display text-xl font-bold leading-tight tracking-tight text-tinta-utama sm:text-2xl">Potensi Desa Blederan</h3>
              </header>

              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <article class="min-w-0 rounded-card border border-kertas-garis bg-white p-4 shadow-sm sm:p-5">
                  <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#EAF2CF] text-sipanen-700" aria-hidden="true"><Ikon nama="daun" ukuran={20} /></span>
                    <h4 class="font-display text-base font-bold text-tinta-utama sm:text-lg">Pertanian</h4>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-tinta-kedua">Lahan budidaya mencakup padi sawah <strong class="text-tinta-utama">52 ha</strong>, cabai <strong class="text-tinta-utama">18 ha</strong>, tomat <strong class="text-tinta-utama">8 ha</strong>, dan jagung <strong class="text-tinta-utama">3 ha</strong>.</p>
                </article>

                <article class="min-w-0 rounded-card border border-kertas-garis bg-white p-4 shadow-sm sm:p-5">
                  <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#EAF2CF] text-sipanen-700" aria-hidden="true"><Ikon nama="gunung" ukuran={20} /></span>
                    <h4 class="font-display text-base font-bold text-tinta-utama sm:text-lg">Wisata dan Alam</h4>
                  </div>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-tinta-kedua">
                    <li><strong class="text-tinta-utama">Agrowisata:</strong> 1 ha, aktif.</li>
                    <li><strong class="text-tinta-utama">Air terjun:</strong> 1 ha, pemanfaatan pasif.</li>
                  </ul>
                </article>

                <article class="min-w-0 rounded-card border border-kertas-garis bg-white p-4 shadow-sm sm:col-span-2 sm:p-5 lg:col-span-1">
                  <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#EAF2CF] text-sipanen-700" aria-hidden="true"><Ikon nama="keranjang" ukuran={20} /></span>
                    <h4 class="font-display text-base font-bold text-tinta-utama sm:text-lg">Produk Lokal</h4>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-tinta-kedua">Pasar desa dikelola BUMDes dan terdapat <strong class="text-tinta-utama">97 pelaku UMKM</strong>. Produk khasnya opak panggang atau opak bakar.</p>
                </article>
              </div>
            </section>

            <p class="mt-4 text-xs leading-relaxed text-tinta-kedua">
              Sumber: Profil Desa dan Kelurahan Blederan 2025 serta materi profil desa dari Pemerintah Desa Blederan 2025.
            </p>
          </div>
        </section>



        {/* Harga hari ini sebagai pembanding kenyataan */}

        <section aria-labelledby="judul-harga" class="relative isolate py-3 sm:py-4">

          <div class="relative z-10 mx-auto max-w-[90rem]">

          <div class="mb-0 flex flex-col gap-0 sm:mb-5 sm:flex-row sm:items-end sm:justify-between sm:gap-3">
            <div>
              <div class="mb-2 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#D5E3A8] bg-[#EAF2CF] px-2.5 py-1 text-xs font-bold text-tinta-utama">
                  Pasar Wonosobo
                </span>
              </div>
              <h2 id="judul-harga" class="font-display text-2xl font-bold tracking-tight text-tinta-utama sm:text-3xl">
                Harga Pasar Hari Ini
              </h2>
            </div>

            <a

              href="/harga"

              class="inline-flex min-h-sentuh self-end items-center text-sm font-bold text-sipanen-800 underline-offset-4 transition-colors hover:text-sipanen-900 hover:underline focus-visible:rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sipanen-700 sm:self-auto"
            >
              Lihat Semua Harga <span class="ml-1" aria-hidden="true">→</span>
            </a>

          </div>



          {

            !hasilHarga || !hasilHarga.ok ? (

              <DataState

                jenis={hasilHarga?.ok === false && hasilHarga.error.code === 'tidak_terhubung' ? 'galat' : 'kosong'}

                pesan={hasilHarga && !hasilHarga.ok ? hasilHarga.error.message : 'Harga belum tersedia.'}

                tautan={{ href: '/harga', label: 'Buka halaman harga' }}

              />

            ) : harga.length === 0 ? (

              <DataState

                jenis="kosong"

                judul="Belum ada catatan harga"

                pesan="Basis data harga untuk wilayah ini masih kosong."

                saran="Pastikan proses pengambilan data harga sudah dijalankan."

              />

            ) : (

              <div class="grid grid-cols-1 gap-2 min-[360px]:grid-cols-2 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">

                {harga.map((h) => {

                  const ilustrasi = ilustrasiKomoditas[h.commodity_code] || '/komoditas/cabai.svg';
                  const naik = h.has_previous && h.change_absolute > 0;

                  const turun = h.has_previous && h.change_absolute < 0;

                  return (

                    <a
                      href={`/harga?bagian=prediksi&komoditas=${h.commodity_id}#tren-prediksi`}
                      aria-label={`Lihat prediksi harga ${h.commodity_name}, harga saat ini ${rupiah(h.price)} per ${h.unit}${h.has_previous ? `. ${naik ? 'Naik' : turun ? 'Turun' : 'Stabil'} ${rupiah(Math.abs(h.change_absolute))} dari kemarin` : ''}`}
                      title={`Lihat prediksi harga ${h.commodity_name}`}
              class="group relative flex min-h-[140px] min-w-0 flex-col gap-4 rounded-2xl border border-kertas-garis border-t-4 border-t-[#ABBED1] bg-white p-3 pb-12 shadow-sm transition-all duration-200 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sipanen-700 motion-reduce:transform-none motion-reduce:transition-none sm:h-full sm:min-h-[220px] sm:justify-start sm:gap-6 sm:p-5 sm:pb-14 sm:hover:-translate-y-1 lg:min-h-[180px] lg:gap-3 lg:pt-4 lg:pl-4 lg:pr-4 lg:pb-12"
                      data-animasi
                    >
                      <div class="flex min-w-0 items-center gap-2">
                        <img src={ilustrasi} alt="" class="h-4 w-4 shrink-0 object-contain drop-shadow-sm transition-transform duration-200 group-hover:scale-105 motion-reduce:transition-none sm:h-5 sm:w-5" loading="lazy" width="48" height="48" />
                        <h3 class="min-w-0 break-words text-xs font-bold leading-tight text-tinta-utama sm:text-sm">{h.commodity_name}</h3>
                      </div>

                      <div class="min-w-0 whitespace-nowrap sm:mt-5 sm:w-full lg:mt-2">
                        <span class="font-display text-lg font-extrabold leading-tight tracking-tight text-tinta-utama sm:text-3xl lg:text-[clamp(1.5rem,2vw,2rem)]">{rupiah(h.price)}</span>
                        <span class="ml-1 text-sm font-semibold text-tinta-kedua">/{h.unit}</span>
                      </div>

                      {h.has_previous && (
                        <div class="absolute bottom-3 left-2 right-2 flex justify-end sm:bottom-4 sm:left-3 sm:right-3">
                          <span class:list={[
                            'inline-flex max-w-full items-center gap-1 rounded-full border px-1.5 py-1 text-[8px] font-semibold leading-tight sm:px-2 sm:text-xs',
                            naik ? 'border-emerald-700 bg-emerald-50 text-emerald-900' : turun ? 'border-red-700 bg-red-50 text-red-900' : 'border-stone-400 bg-stone-100 text-stone-800',
                          ]}>
                            <IkonArahHarga arah={naik ? 'naik' : turun ? 'turun' : 'stabil'} ukuran={10} />
                            <span class="whitespace-nowrap">{naik ? `Naik ${rupiah(Math.abs(h.change_absolute))}` : turun ? `Turun ${rupiah(Math.abs(h.change_absolute))}` : 'Harga tetap'} dari kemarin</span>
                          </span>
                        </div>
                      )}
                    </a>

                  );

                })}

              </div>

            )

          }



          </div>

        </section>



        <section class="relative isolate !mt-10 py-8 sm:py-10 before:absolute before:inset-y-0 before:left-1/2 before:z-0 before:w-screen before:-translate-x-1/2 before:bg-white" aria-labelledby="judul-layanan">
          <div class="relative z-10">

          <div class="mx-auto mb-6 max-w-2xl text-center">

            <p class="mb-2 text-xs font-bold uppercase tracking-[0.14em] text-sipanen-800 sm:text-sm">Layanan SiPanen</p>

            <h2 id="judul-layanan" class="scroll-mt-24 font-display text-2xl font-bold leading-tight tracking-tight text-tinta-utama sm:scroll-mt-40 sm:text-3xl">Apa yang ingin Anda cari?</h2>

            <p class="mt-3 text-sm leading-relaxed text-tinta-kedua sm:text-base">Pilih kebutuhan Anda untuk langsung membuka informasi yang tepat.</p>

          </div>

          <div class="mx-auto grid max-w-[90rem] gap-4 sm:grid-cols-2 lg:grid-cols-4">

            {fitur.map((f) => (

              <a

                href={f.href}

                class="group flex h-full min-h-[168px] flex-col items-center rounded-card border border-kertas-garis bg-white p-3 text-center text-tinta-utama shadow-[0_4px_14px_rgba(38,50,56,0.12)] transition-all duration-200 ease-out hover:-translate-y-1 hover:border-sipanen-600 hover:shadow-[0_12px_28px_rgba(100,144,46,0.2)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sipanen-700 active:translate-y-0 active:scale-[0.99] motion-reduce:transform-none motion-reduce:transition-none sm:min-h-[180px] sm:p-4 dark:bg-[#4D4D4D] dark:text-[#F8F9FA] dark:shadow-[0_4px_14px_rgba(248,249,250,0.08)] dark:hover:border-sipanen-400 dark:hover:shadow-[0_0_20px_rgba(248,249,250,0.2)]"

                data-animasi

              >

                <span class:list={[

                  'mb-3 inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-[#EAF2CF] text-tinta-utama ring-1 ring-inset ring-[#D5E3A8] transition-all duration-200 group-hover:scale-105 group-hover:bg-[#CFEB73] group-hover:shadow-md sm:mb-4 sm:h-12 sm:w-12 dark:bg-[#99B82E]/15 dark:text-[#F8F9FA] dark:ring-[#99B82E]/50 dark:group-hover:bg-[#99B82E]/25',

                ]}>

                  <Ikon nama={f.ikon} ukuran={22} kelas="transition-transform duration-200 group-hover:scale-110 sm:h-6 sm:w-6" />

                </span>

                <span class="font-display text-base font-bold leading-snug transition-colors group-hover:text-sipanen-800 dark:group-hover:text-lime-200 sm:text-lg">{f.judul}</span>

                <span class="mt-1.5 flex-1 text-sm text-tinta-kedua dark:text-[#F8F9FA]/80">{f.isi}</span>

              </a>

            ))}

          </div>
          </div>

        </section>



        {/* Saran tanam: bagian terpenting, diletakkan paling atas */}

</div>

    )

  }

</MainLayout>



