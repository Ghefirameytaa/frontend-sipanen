---
/**
 * PriceTable — Tampilan Harga Terkini 4 Komoditas Pertanian Wonosobo.
 *
 * Mengadopsi tata letak kartu responsif 4 kolom di desktop, 2 kolom di tablet,
 * dan 1 kolom di mobile, dengan aksen warna alami komoditas, ilustrasi tajam,
 * dan indikator perubahan harga dibanding hari kemarin.
 */
import type { PriceItem } from '../lib/api';
import { rupiah, tanggalPanjang, persen, selisihHari } from '../lib/api';
import { warnaKomoditas } from '../lib/komoditas';
import DataSourceBadge from './DataSourceBadge.astro';
import Ikon from './Ikon.astro';
import Lipatan from './Lipatan.astro';

export interface Props {
  harga: PriceItem[];
}

const { harga } = Astro.props;

function kindBadge(kind: string): 'aktual' | 'simulasi' | 'tidak_diketahui' {
  if (kind === 'aktual') return 'aktual';
  if (kind === 'simulasi') return 'simulasi';
  return 'tidak_diketahui';
}

const ilustrasiKomoditas: Record<string, string> = {
  'cabai-keriting': '/komoditas/cabai-merah-keriting.png',
  'cabai-rawit-merah': '/komoditas/cabai-rawit-merah.png',
  'cabai-rawit-hijau': '/komoditas/cabai-rawit-hijau.png',
  tomat: '/komoditas/tomat-kalender.png',
  'tomat-besar': '/komoditas/tomat-kalender.png',
  'tomat-kecil': '/komoditas/tomat-kalender.png',
};

const temaKomoditas: Record<string, { topBorder: string; badgeBg: string; textAccent: string; ringColor: string }> = {
  'cabai-keriting': {
    topBorder: 'border-t-red-600',
    badgeBg: 'bg-red-50 text-red-700 border-red-200',
    textAccent: 'text-red-700',
    ringColor: 'hover:border-red-300',
  },
  'cabai-rawit-merah': {
    topBorder: 'border-t-rose-600',
    badgeBg: 'bg-rose-50 text-rose-800 border-rose-200',
    textAccent: 'text-rose-800',
    ringColor: 'hover:border-rose-300',
  },
  'cabai-rawit-hijau': {
    topBorder: 'border-t-emerald-600',
    badgeBg: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    textAccent: 'text-emerald-800',
    ringColor: 'hover:border-emerald-300',
  },
  tomat: {
    topBorder: 'border-t-amber-500',
    badgeBg: 'bg-amber-50 text-amber-800 border-amber-200',
    textAccent: 'text-amber-800',
    ringColor: 'hover:border-amber-300',
  },
};
---

<div class="space-y-6">
  <!-- Kisi Kartu 4 Komoditas: 1 Kolom Mobile, 2 Tablet, 4 Desktop -->
  <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
    {
      harga.map((h) => {
        const naik = h.has_previous && h.change_absolute > 0;
        const turun = h.has_previous && h.change_absolute < 0;
        const tetap = h.has_previous && h.change_absolute === 0;
        const umur = selisihHari(h.date);
        const basi = umur !== null && umur < -7;
        const ilustrasi = ilustrasiKomoditas[h.commodity_code] || '/komoditas/cabai.svg';
        const tema = temaKomoditas[h.commodity_code] || {
          topBorder: 'border-t-sipanen-600',
          badgeBg: 'bg-sipanen-50 text-sipanen-800 border-sipanen-200',
          textAccent: 'text-sipanen-800',
          ringColor: 'hover:border-sipanen-300',
        };

        return (
          <li
            class:list={[
              'group relative flex flex-col justify-between rounded-2xl border border-kertas-garis bg-white p-3 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg sm:p-5',
              tema.topBorder,
              tema.ringColor,
              'border-t-4',
            ]}
            data-animasi
          >
            <!-- Header Kartu -->
            <div>
              <div class="flex items-start justify-between gap-2 sm:gap-3">
                <div class="flex min-w-0 items-center gap-2 sm:gap-3">
                  <div class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-stone-50 p-1.5 transition-transform duration-300 group-hover:scale-110 sm:h-12 sm:w-12">
                    <img
                      src={ilustrasi}
                      alt={h.commodity_name}
                      class="h-full w-full object-contain drop-shadow-sm"
                      loading="lazy"
                      width="48"
                      height="48"
                    />
                  </div>
                  <div>
                    <h3 class="text-sm font-bold leading-snug text-tinta-utama transition-colors group-hover:text-sipanen-800 sm:text-base">
                      {h.commodity_name}
                    </h3>
                    <p class="text-xs text-tinta-kedua">
                      {h.variety && h.variety !== h.commodity_name ? `${h.variety} · ` : ''}per {h.unit}
                    </p>
                  </div>
                </div>
                <DataSourceBadge kind={kindBadge(h.data_kind)} ukuran="kecil" />
              </div>

              <!-- Angka Harga Utama -->
              <div class="mt-4 border-t border-dashed border-stone-100 pt-3 sm:mt-5 sm:pt-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-tinta-redup">
                  Harga Hari Ini
                </p>
                <div class="mt-1 flex items-baseline gap-1.5">
                  <span class="font-display text-2xl font-extrabold tracking-tight text-tinta-utama sm:text-4xl">
                    {rupiah(h.price)}
                  </span>
                  <span class="text-xs font-semibold text-tinta-kedua">/{h.unit}</span>
                </div>
              </div>

              <!-- Status Perubahan dibanding Kemarin -->
              <div class="mt-4">
                {h.has_previous ? (
                  <div
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-xs font-bold transition-colors',
                      naik
                        ? 'border-red-200 bg-red-50 text-red-700'
                        : turun
                        ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                        : 'border-stone-200 bg-stone-50 text-stone-600',
                    ]}
                  >
                    <span class="text-sm leading-none" aria-hidden="true">
                      {naik ? '▲' : turun ? '▼' : '■'}
                    </span>
                    <span>
                      {naik ? 'Naik' : turun ? 'Turun' : 'Stabil'}{' '}
                      {tetap ? '(0%)' : persen(h.change_percent)}
                    </span>
                    {h.change_absolute !== 0 && (
                      <span class="opacity-75 font-normal">
                        ({naik ? '+' : ''}{rupiah(h.change_absolute)})
                      </span>
                    )}
                  </div>
                ) : (
                  <span class="inline-flex items-center gap-1 text-xs text-tinta-kedua">
                    <Ikon nama="tanya" ukuran={16} />
                    Catatan perdana
                  </span>
                )}

                {h.has_previous && (
                  <p class="mt-1.5 text-[11px] text-tinta-redup">
                    Kemarin: {rupiah(h.previous_price)} ({tanggalPanjang(h.previous_date)})
                  </p>
                )}
              </div>
            </div>

            <!-- Footer Kartu & Shortcut Prediksi -->
            <div class="mt-6 border-t border-stone-100 pt-3">
              <div class="flex items-center justify-between text-xs">
                <span class="text-[11px] text-tinta-redup">
                  Tercatat: {tanggalPanjang(h.date)}
                </span>
                <a
                  href={`/harga?bagian=prediksi&komoditas=${h.commodity_id}`}
                  class="group/link inline-flex items-center gap-1 font-bold text-sipanen-700 transition-colors hover:text-sipanen-900"
                  title={`Lihat proyeksi harga ${h.commodity_name} 5 hari ke depan`}
                >
                  <span>Prediksi</span>
                  <span class="transition-transform duration-200 group-hover/link:translate-x-0.5" aria-hidden="true">→</span>
                </a>
              </div>

              {basi && (
                <p class="mt-1 flex items-center gap-1 text-[11px] font-semibold text-amber-800">
                  <Ikon nama="peringatan" ukuran={14} />
                  Belum diperbarui sejak {Math.abs(umur!)} hari
                </p>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>

  <!-- Lipatan Tabel Data Lengkap -->
  <Lipatan judul="Lihat rincian sebagai tabel pembanding" ikon="banding">
    <div class="overflow-x-auto -mx-1 px-1">
      <table class="w-full min-w-[44rem] border-collapse text-left">
        <caption class="sr-only">Tabel perbandingan harga 4 komoditas</caption>
        <thead>
          <tr class="border-b-2 border-kertas-garis bg-stone-50/70 text-xs font-bold uppercase tracking-wider text-tinta-kedua">
            <th scope="col" class="px-4 py-3">Komoditas</th>
            <th scope="col" class="px-4 py-3 text-right">Harga Hari Ini</th>
            <th scope="col" class="px-4 py-3 text-right">Harga Kemarin</th>
            <th scope="col" class="px-4 py-3 text-center">Perubahan</th>
            <th scope="col" class="px-4 py-3">Tanggal Catat</th>
            <th scope="col" class="px-4 py-3">Asal Data</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100 text-sm">
          {
            harga.map((h) => {
              const naik = h.has_previous && h.change_absolute > 0;
              const turun = h.has_previous && h.change_absolute < 0;
              const ilustrasi = ilustrasiKomoditas[h.commodity_code] || '/komoditas/cabai.svg';

              return (
                <tr class="transition-colors hover:bg-sipanen-50/40">
                  <th scope="row" class="px-4 py-3.5 font-semibold text-tinta-utama">
                    <div class="flex items-center gap-2.5">
                      <img src={ilustrasi} alt="" class="h-6 w-6 object-contain" />
                      <div>
                        <span>{h.commodity_name}</span>
                        <span class="block text-xs font-normal text-tinta-redup">per {h.unit}</span>
                      </div>
                    </div>
                  </th>
                  <td class="px-4 py-3.5 text-right font-display text-base font-bold tabular-nums text-tinta-utama">
                    {rupiah(h.price)}
                  </td>
                  <td class="px-4 py-3.5 text-right tabular-nums text-tinta-kedua">
                    {h.has_previous ? rupiah(h.previous_price) : '-'}
                  </td>
                  <td class="px-4 py-3.5 text-center">
                    {h.has_previous ? (
                      <span
                        class:list={[
                          'inline-flex items-center gap-1 rounded px-2 py-0.5 text-xs font-bold',
                          naik
                            ? 'bg-red-50 text-red-700'
                            : turun
                            ? 'bg-emerald-50 text-emerald-700'
                            : 'bg-stone-100 text-stone-600',
                        ]}
                      >
                        {naik ? '▲ +' : turun ? '▼ ' : '■ '}
                        {persen(h.change_percent)}
                      </span>
                    ) : (
                      <span class="text-xs text-tinta-redup">awal</span>
                    )}
                  </td>
                  <td class="px-4 py-3.5 text-xs text-tinta-kedua whitespace-nowrap">
                    {tanggalPanjang(h.date)}
                  </td>
                  <td class="px-4 py-3.5">
                    <DataSourceBadge kind={kindBadge(h.data_kind)} sumber={h.source} ukuran="kecil" />
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </Lipatan>
</div>
