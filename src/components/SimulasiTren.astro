---
import DataSourceBadge from './DataSourceBadge.astro';
import type { PriceItem } from '../lib/api';
import { rupiah, tanggalPanjang } from '../lib/api';

export interface Props {
  harga: PriceItem;
  hari: number;
  skenario: 'naik' | 'stabil' | 'turun';
}

const { harga, hari, skenario } = Astro.props;
const pilihan = [
  { id: 'naik', nama: 'Naik 10%', perubahan: 0.1 },
  { id: 'stabil', nama: 'Stabil', perubahan: 0 },
  { id: 'turun', nama: 'Turun 10%', perubahan: -0.1 },
] as const;
const terpilih = pilihan.find((item) => item.id === skenario) ?? pilihan[1];

// Ilustrasi skenario dimulai dari harga aktual, lalu garis tengah bergerak
// secara linear. Pita 3%-12% sengaja hanya contoh, bukan interval model.
const titik = Array.from({ length: 13 }, (_, indeks) => {
  const t = indeks / 12;
  const tengah = harga.price * (1 + terpilih.perubahan * t);
  const lebarPita = 0.03 + 0.09 * t;
  return {
    hari: Math.round(hari * t),
    tengah,
    bawah: tengah * (1 - lebarPita),
    atas: tengah * (1 + lebarPita),
  };
});

const lebar = 780;
const tinggi = 320;
const kiri = 104;
const kanan = 20;
const atas = 20;
const bawah = 54;
const lebarGrafik = lebar - kiri - kanan;
const tinggiGrafik = tinggi - atas - bawah;
const nilaiMin = Math.max(0, Math.min(...titik.map((item) => item.bawah)) * 0.96);
const nilaiMax = Math.max(...titik.map((item) => item.atas)) * 1.04;
const x = (indeks: number) => kiri + (indeks / (titik.length - 1)) * lebarGrafik;
const y = (nilai: number) => atas + ((nilaiMax - nilai) / (nilaiMax - nilaiMin)) * tinggiGrafik;
const jalurTengah = titik.map((item, indeks) => `${x(indeks)},${y(item.tengah)}`).join(' ');
const jalurPita = [
  ...titik.map((item, indeks) => `${x(indeks)},${y(item.atas)}`),
  ...titik.slice().reverse().map((item, urutan) => `${x(titik.length - 1 - urutan)},${y(item.bawah)}`),
].join(' ');
const titikAkhir = titik[titik.length - 1];
const fraksiSumbu = [0, 0.5, 1];
const nilaiSumbu = fraksiSumbu.map((fraksi) => nilaiMax - (nilaiMax - nilaiMin) * fraksi);
const formatParam = (skenarioId: string, jumlahHari = hari) =>
  `/harga?bagian=prediksi&komoditas=${harga.commodity_id}&hari=${jumlahHari}&skenario=${skenarioId}`;
---

<section class="space-y-5 rounded-card border border-stone-300 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="judul-simulasi-tren">
  <div class="rounded-xl border border-stone-300 bg-stone-50 p-4" role="note">
    <div class="flex flex-wrap items-center gap-2">
      <DataSourceBadge kind="simulasi" />
      <DataSourceBadge kind="aktual" sumber={harga.source} />
    </div>
    <h3 id="judul-simulasi-tren" class="mt-3 font-display text-2xl font-bold text-tinta-utama">Ilustrasi tren harga {harga.commodity_name}</h3>
    <p class="mt-2 max-w-4xl text-sm leading-relaxed text-tinta-utama">
      Belum ada hasil model. Grafik ini hanya memperagakan kemungkinan arah harga, bukan ramalan: titik awalnya harga aktual {rupiah(harga.price)} per {harga.unit} pada {tanggalPanjang(harga.date)}; garis tengah mengikuti skenario pilihan dan pita rentangnya dibuat sebagai contoh. Jangan gunakan angka simulasi ini untuk keputusan jual atau tanam.
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-tinta-kedua">Skenario ilustrasi</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {pilihan.map((item) => (
          <a
            href={formatParam(item.id)}
            aria-current={item.id === skenario ? 'true' : undefined}
            class:list={[
              'inline-flex min-h-sentuh items-center rounded-full border px-4 py-2 text-sm font-bold transition-colors',
              item.id === skenario
                ? 'border-[#B9D0AD] bg-[#DCE9D2] text-[#125112] hover:bg-[#C5D9BC]'
                : 'border-[#C7D2DF] bg-white text-[#344054] hover:bg-[#C5D9BC]',
            ]}
          >
            {item.nama}
          </a>
        ))}
      </div>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-tinta-kedua">Rentang contoh</p>
      <div class="mt-2 flex gap-2">
        {[30, 60, 90].map((jumlahHari) => (
          <a
            href={formatParam(skenario, jumlahHari)}
            aria-current={jumlahHari === hari ? 'true' : undefined}
            class:list={[
              'inline-flex min-h-sentuh min-w-12 items-center justify-center rounded-full border px-3 py-2 text-sm font-bold transition-colors',
              jumlahHari === hari
                ? 'border-[#B9D0AD] bg-[#DCE9D2] text-[#125112] hover:bg-[#C5D9BC]'
                : 'border-[#C7D2DF] bg-white text-[#344054] hover:bg-[#C5D9BC]',
            ]}
          >
            {jumlahHari} hari
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-3">
    <div class="rounded-xl border border-kertas-garis bg-sipanen-50/60 p-4">
      <p class="text-xs font-semibold uppercase text-tinta-kedua">Harga aktual sebagai titik awal</p>
      <p class="mt-1 text-xl font-extrabold tabular-nums text-sipanen-900">{rupiah(harga.price)} <span class="text-sm font-medium">/ {harga.unit}</span></p>
    </div>
    <div class="rounded-xl border border-kertas-garis bg-white p-4">
      <p class="text-xs font-semibold uppercase text-tinta-kedua">Nilai tengah skenario hari ke-{hari}</p>
      <p class="mt-1 text-xl font-extrabold tabular-nums text-tinta-utama">{rupiah(titikAkhir.tengah)} <span class="text-sm font-medium">/ {harga.unit}</span></p>
    </div>
    <div class="rounded-xl border border-kertas-garis bg-kertas-lembut p-4">
      <p class="text-xs font-semibold uppercase text-tinta-kedua">Rentang contoh hari ke-{hari}</p>
      <p class="mt-1 text-lg font-extrabold tabular-nums text-tinta-utama">{rupiah(titikAkhir.bawah)} – {rupiah(titikAkhir.atas)}</p>
    </div>
  </div>

  <div class="overflow-x-auto rounded-xl border border-kertas-garis bg-kertas-lembut p-2 sm:p-4">
    <svg viewBox={`0 0 ${lebar} ${tinggi}`} class="h-auto min-w-[34rem] w-full" role="img" aria-labelledby="judul-grafik-simulasi deskripsi-grafik-simulasi">
      <title id="judul-grafik-simulasi">Ilustrasi skenario {terpilih.nama.toLowerCase()} harga {harga.commodity_name}</title>
      <desc id="deskripsi-grafik-simulasi">Garis tengah menunjukkan skenario ilustrasi, sedangkan bidang hijau menunjukkan rentang contoh yang melebar hingga hari ke-{hari}. Ini bukan hasil model prediksi.</desc>
      {fraksiSumbu.map((fraksi, indeks) => (
        <g>
          <line x1={kiri} x2={lebar - kanan} y1={atas + tinggiGrafik * fraksi} y2={atas + tinggiGrafik * fraksi} stroke="#ABBED1" stroke-dasharray="4 5" />
          <text x={kiri - 10} y={atas + tinggiGrafik * fraksi + 5} text-anchor="end" fill="currentColor" font-size="12">{rupiah(nilaiSumbu[indeks])}</text>
        </g>
      ))}
      <polygon points={jalurPita} fill="#C0F283" fill-opacity="0.58" />
      <polyline points={jalurTengah} fill="none" stroke="#64902E" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx={x(0)} cy={y(titik[0].tengah)} r="6" fill="#64902E" stroke="white" stroke-width="3" />
      <circle cx={x(titik.length - 1)} cy={y(titikAkhir.tengah)} r="6" fill="#64902E" stroke="white" stroke-width="3" />
      {[0, 6, 12].map((indeks) => (
        <text x={x(indeks)} y={tinggi - 18} text-anchor={indeks === 0 ? 'start' : indeks === 12 ? 'end' : 'middle'} fill="currentColor" font-size="12">Hari ke-{titik[indeks].hari}</text>
      ))}
    </svg>
  </div>
  <p class="text-xs leading-relaxed text-tinta-kedua">Garis menunjukkan arah skenario, bukan arah pasar sebenarnya. Rentang hijau 3%–12% adalah ilustrasi ketidakpastian, bukan hasil pengukuran akurasi. Jika model prediksi tersedia, hasil model akan ditampilkan menggantikan ilustrasi ini.</p>
</section>
