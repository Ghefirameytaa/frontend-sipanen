---
/**
 * ForecastChart — grafik riwayat harga dan perkiraan ke depan.
 *
 * TIGA HAL YANG WAJIB TAMPIL BERSAMA GRAFIK INI
 * ----------------------------------------------
 * Ketentuan proyek melarang prediksi disajikan sebagai kepastian. Karena itu
 * grafik ini tidak pernah tampil sendirian:
 *
 *  1. Pita ketidakpastian — rentang bawah dan atas selalu digambar. Grafik
 *     prediksi tanpa rentang membuat angka tengah tampak seperti kepastian.
 *  2. Angka batas bawah dan batas atas — selalu tertulis, tidak hanya digambar.
 *     Kanvas tidak terbaca pembaca layar dan tidak terbaca saat dicetak.
 *  3. Catatan akurasi — hasil evaluasi model apa adanya, termasuk ketika model
 *     kalah dari cara sederhana, dan termasuk ketika belum pernah diuji.
 *
 * YANG BERUBAH
 * ------------
 * Sebelumnya bagian akurasi berupa dua paragraf. Bagi pembaca lanjut usia,
 * pertanyaan "seberapa jauh model ini bisa meleset?" jauh lebih cepat dijawab
 * oleh dua batang yang panjangnya sebanding daripada oleh dua angka di tengah
 * kalimat. Karena itu galat model dan galat cara sederhana kini digambar
 * sebagai `BatangBanding` — tetapi angka rupiahnya tetap tertulis penuh, dan
 * putusannya tetap satu kalimat utuh yang selalu tampil, termasuk kalimat yang
 * menyatakan model KALAH.
 *
 * Paragraf penjelasannya tidak dihapus; ia dipindahkan ke `Lipatan`.
 */
import type { ForecastSeries } from '../lib/api';
import { rupiah, tanggalPanjang, tanggalRingkas } from '../lib/api';
import { sebutanRentang, lebarRentang } from '../lib/rentang';
import BatangBanding from './BatangBanding.astro';
import DataSourceBadge from './DataSourceBadge.astro';
import Ikon from './Ikon.astro';
import Lencana from './Lencana.astro';
import Lipatan from './Lipatan.astro';
import PitaPasti from './PitaPasti.astro';

export interface Props {
  seri: ForecastSeries;
  /**
   * Berapa banyak titik perkiraan yang ditampilkan pada tabel. Grafik tetap
   * memuat seluruhnya; tabel dibatasi agar tidak menjadi ratusan baris yang
   * tidak terbaca.
   */
  barisTabel?: number;
}

const { seri, barisTabel = 14 } = Astro.props;

const idUnik = `grafik-${seri.commodity_code}-${Math.random().toString(36).slice(2, 8)}`;
const idKonfigurasi = `${idUnik}-data`;

const labels = [
  ...seri.history.map((h) => tanggalRingkas(h.date)),
  ...seri.forecast.map((f) => tanggalRingkas(f.date)),
];

// Deret riwayat diisi sampai ujung, deret perkiraan dibiarkan kosong di bagian
// riwayat. Titik sambungnya ditambahkan oleh penggambar grafik.
const kosongRiwayat = new Array(seri.forecast.length).fill(null);
const kosongPerkiraan = new Array(seri.history.length).fill(null);

const konfigurasi = {
  labels,
  riwayat: [...seri.history.map((h) => h.price), ...kosongRiwayat],
  perkiraan: [...kosongPerkiraan, ...seri.forecast.map((f) => f.predicted)],
  atas: [...kosongPerkiraan, ...seri.forecast.map((f) => f.upper)],
  bawah: [...kosongPerkiraan, ...seri.forecast.map((f) => f.lower)],
  satuan: seri.unit || 'kg',
  judul: seri.commodity_name,
};

// `</script>` di dalam JSON akan menutup blok skrip lebih awal, jadi karakter
// `<` di-escape. Isinya sendiri hanya tanggal dan angka, tetapi datanya tetap
// diperlakukan sebagai teks yang tidak dipercaya.
const konfigurasiAman = JSON.stringify(konfigurasi).replace(/</g, '\\u003c');

const titikTerakhir = seri.forecast[seri.forecast.length - 1];

const selisih =
  seri.current_price > 0 && titikTerakhir
    ? ((titikTerakhir.predicted - seri.current_price) / seri.current_price) * 100
    : null;

// Putusan sekilas, ditampilkan DI ATAS grafik supaya pembaca yang tidak
// mengikuti garis tetap membawa pulang arah dan lebarnya rentang.
const arah =
  selisih === null
    ? { nada: 'netral' as const, teks: 'Arah belum dapat dihitung', ikon: 'tanya' }
    : selisih >= 0
      ? { nada: 'bagus' as const, teks: 'Perkiraan harga naik', ikon: 'panah-naik' }
      : { nada: 'hati' as const, teks: 'Perkiraan harga turun', ikon: 'panah-turun' };

const lebarTerakhir = titikTerakhir
  ? lebarRentang(titikTerakhir.lower, titikTerakhir.predicted, titikTerakhir.upper)
  : Number.NaN;
const putusanRentang = sebutanRentang(lebarTerakhir);

const barisPerkiraan = seri.forecast.slice(0, barisTabel);
const adaRiwayat = seri.history.length > 0;

// Akurasi: hanya bermakna bila sudah dievaluasi DAN ada pembandingnya.
const adaAkurasi = seri.accuracy.evaluated;
const adaPembanding = adaAkurasi && Boolean(seri.accuracy.baseline_name);

const putusanAkurasi = !adaAkurasi
  ? { nada: 'hati' as const, teks: 'Model belum pernah diuji', ikon: 'tanya' }
  : seri.accuracy.beats_baseline
    ? { nada: 'bagus' as const, teks: 'Model lebih baik', ikon: 'centang' }
    : { nada: 'hati' as const, teks: 'Model belum lebih baik', ikon: 'peringatan' };
---

<section class="space-y-5">
  <header class="border-b border-kertas-garis pb-4">
    <div class="flex flex-wrap items-center gap-3 justify-between">
      <h2 class="text-2xl font-bold">
        {seri.commodity_name}
        <span class="text-tinta-redup font-medium text-lg">({seri.variety})</span>
      </h2>
      <div class="flex flex-wrap items-center gap-2">
        <DataSourceBadge kind="prediksi" />
        <DataSourceBadge kind="aktual" ukuran="kecil" />
      </div>
    </div>

    {
      adaRiwayat && (
        <p class="text-tinta-kedua mt-2">
          Harga terakhir tercatat <strong>{rupiah(seri.current_price)}</strong> per {seri.unit} pada{' '}
          {tanggalPanjang(seri.current_price_date)}.
        </p>
      )
    }
  </header>

  <div class="space-y-5">
    <!-- Jalur putusan: dua hal yang paling sering ditanyakan, dijawab sebelum
         grafiknya dilihat. -->
    <div class="flex flex-wrap gap-3">
      <Lencana nada={arah.nada} teks={arah.teks} ikon={arah.ikon} ukuran="besar" />
      {
        titikTerakhir && (
          <Lencana nada={putusanRentang.nada} teks={putusanRentang.teks} ikon="banding" ukuran="besar" />
        )
      }
    </div>

    <!-- Keterangan garis. Ditulis di HTML, bukan di dalam kanvas, agar
         ukurannya dapat diperbesar dan terbaca pembaca layar. -->
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-lg" aria-label="Keterangan grafik">
      <li class="flex items-center gap-2">
        <span class="w-8 h-1 rounded bg-sipanen-700" aria-hidden="true"></span>
        <span>Sudah terjadi</span>
      </li>
      <li class="flex items-center gap-2">
        <span
          class="w-8 h-1 rounded"
          style="background-image: repeating-linear-gradient(90deg,#309CF6 0 8px,transparent 8px 14px);"
          aria-hidden="true"
        ></span>
        <span>Perkiraan</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="w-4 h-3 rounded-sm" style="background-color: rgba(48,156,246,0.18);" aria-hidden="true"
        ></span>
        <span>Rentang kemungkinan</span>
      </li>
    </ul>

    <div class="relative" style="height: 320px;">
      <canvas
        data-grafik="prediksi"
        data-konfigurasi={idKonfigurasi}
        role="img"
        aria-label={`Grafik harga dan perkiraan harga ${seri.commodity_name} dalam rupiah per ${seri.unit}. Angka lengkap tersedia pada tabel di bawah grafik.`}
      ></canvas>
    </div>

    <script type="application/json" id={idKonfigurasi} set:html={konfigurasiAman} />

    <!-- Angka perkiraan pada hari terjauh. Batas bawah dan batas atas WAJIB
         tertulis; grafik saja tidak cukup. -->
    {
      titikTerakhir && (
        <div>
          <h3 class="font-bold text-xl mb-3 flex items-center gap-2">
            <Ikon nama="prediksi" ukuran={24} />
            Perkiraan pada {tanggalPanjang(titikTerakhir.date)}
          </h3>
          <PitaPasti
            teksBawah={rupiah(titikTerakhir.lower)}
            teksTengah={rupiah(titikTerakhir.predicted)}
            teksAtas={rupiah(titikTerakhir.upper)}
            nilaiBawah={titikTerakhir.lower}
            nilaiTengah={titikTerakhir.predicted}
            nilaiAtas={titikTerakhir.upper}
            persen={lebarTerakhir}
            satuan={seri.unit}
          />
        </div>
      )
    }

    <!-- Perbandingan dengan harga terakhir. Dua batang, supaya selisihnya
         terlihat tanpa membaca kalimat. -->
    {
      titikTerakhir && selisih !== null && (
        <BatangBanding
          kiri={{
            label: 'Harga terakhir',
            nilai: seri.current_price,
            teks: rupiah(seri.current_price),
            nada: 'netral',
          }}
          kanan={{
            label: `Perkiraan ${tanggalPanjang(titikTerakhir.date)}`,
            nilai: titikTerakhir.predicted,
            teks: rupiah(titikTerakhir.predicted),
            nada: selisih >= 0 ? 'utama' : 'peringatan',
          }}
          keterangan={`Angka tengah perkiraan ${selisih >= 0 ? 'lebih tinggi' : 'lebih rendah'} sekitar ${Math.abs(selisih).toFixed(1)}% dari harga terakhir. Perkiraan, bukan janji.`}
        />
      )
    }

    <!-- ── Akurasi ──────────────────────────────────────────────────────────
         Ditampilkan apa adanya, termasuk ketika model kalah dan ketika model
         belum pernah diuji. -->
    <div class="border-t border-kertas-garis pt-4 space-y-4">
      <h3 class="font-bold text-xl flex items-center gap-2">
        <Ikon nama="banding" ukuran={24} />
        Seberapa jauh model ini bisa meleset?
      </h3>

      <Lencana
        nada={putusanAkurasi.nada}
        teks={putusanAkurasi.teks}
        ikon={putusanAkurasi.ikon}
        ukuran="besar"
      />

      {
        adaAkurasi ? (
          <div class="space-y-4">
            {adaPembanding && (
              <BatangBanding
                kiri={{
                  label: 'Selisih model ini',
                  nilai: seri.accuracy.mae,
                  teks: rupiah(seri.accuracy.mae),
                  nada: seri.accuracy.beats_baseline ? 'utama' : 'peringatan',
                }}
                kanan={{
                  label: `Selisih cara sederhana`,
                  nilai: seri.accuracy.baseline_mae,
                  teks: rupiah(seri.accuracy.baseline_mae),
                  nada: 'netral',
                }}
                keterangan={`Makin pendek batangnya, makin dekat ke kenyataan. Diukur pada ${seri.accuracy.test_rows} hari data yang tidak dipakai melatih model.`}
              />
            )}

            {/* Satu kalimat putusan yang selalu tampil — terutama kalimat yang
                menyatakan model BELUM lebih baik. Ini tidak boleh tersembunyi
                di dalam lipatan. */}
            <p
              class:list={[
                'font-semibold text-lg',
                seri.accuracy.beats_baseline ? 'text-sipanen-800' : 'text-amber-900',
              ]}
            >
              {
                adaPembanding
                  ? seri.accuracy.beats_baseline
                    ? `Model ini lebih dekat ke kenyataan daripada cara sederhana (menganggap harga besok sama dengan hari ini). Rata-rata meleset ${rupiah(seri.accuracy.mae)} per ${seri.unit}.`
                    : `Model ini belum terbukti lebih baik daripada cara sederhana (menganggap harga besok sama dengan hari ini). Rata-rata model meleset ${rupiah(seri.accuracy.mae)}, cara sederhana ${rupiah(seri.accuracy.baseline_mae)}. Jangan bersandar pada angkanya saja.`
                  : `Model ini sudah diuji, tetapi belum ada pembandingnya. Rata-rata meleset ${rupiah(seri.accuracy.mae)} per ${seri.unit}.`
              }
            </p>

            <Lipatan judul="Rincian pengujian" ikon="buku">
              <div class="space-y-2">
                <p>
                  Rata-rata selisih antara perkiraan dan kenyataan adalah{' '}
                  <strong>{rupiah(seri.accuracy.mae)}</strong> per {seri.unit}
                  {seri.accuracy.mape > 0 && (
                    <>
                      , atau sekitar <strong>{seri.accuracy.mape.toFixed(1)}%</strong>
                    </>
                  )}
                  .
                </p>
                {seri.accuracy.baseline_name && (
                  <p>
                    Pembandingnya adalah cara paling sederhana: menganggap harga besok sama dengan
                    hari ini (<em>{seri.accuracy.baseline_name}</em>). Cara itu menghasilkan
                    selisih {rupiah(seri.accuracy.baseline_mae)}.
                  </p>
                )}
                <p class="text-sm text-tinta-redup">
                  Diuji pada {seri.accuracy.test_rows} hari data yang tidak dipakai melatih model.
                  Versi model {seri.accuracy.model_version || '—'}.
                  {seri.accuracy.notes ? ` ${seri.accuracy.notes}` : ''}
                </p>
              </div>
            </Lipatan>
          </div>
        ) : (
          <p class="text-amber-900 text-lg">
            Model untuk komoditas ini <strong>belum pernah diuji</strong>, sehingga tingkat
            ketepatannya belum diketahui. Angka perkiraan di atas tetap dapat dilihat, tetapi
            perlakukan sebagai gambaran kasar — bukan hasil yang sudah terukur.
          </p>
        )
      }
    </div>
  </div>

  <!--
    Tabel angka. Wajib ada: pembaca layar tidak dapat membaca kanvas, dan
    sebagian pembaca lanjut usia jauh lebih mudah membaca baris angka.
    Bentuknya `Lipatan` supaya seragam dengan tombol buka-tutup lain di
    dashboard.
  -->
  <div class="border-t border-kertas-garis pt-4">
    <Lipatan judul={`Lihat angka perkiraan (${seri.forecast.length} hari)`} ikon="banding">
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <caption class="sr-only">
            Perkiraan harga {seri.commodity_name} per hari beserta rentangnya
          </caption>
          <thead>
            <tr class="text-left border-b-2 border-kertas-garis">
              <th scope="col" class="py-3 pr-4 font-bold">Tanggal</th>
              <th scope="col" class="py-3 pr-4 font-bold text-right">Terendah</th>
              <th scope="col" class="py-3 pr-4 font-bold text-right">Angka tengah</th>
              <th scope="col" class="py-3 font-bold text-right">Tertinggi</th>
            </tr>
          </thead>
          <tbody>
            {
              barisPerkiraan.map((f) => (
                <tr class="border-b border-kertas-garis">
                  <th scope="row" class="py-3 pr-4 font-medium text-left">
                    {tanggalPanjang(f.date)}
                  </th>
                  <td class="py-3 pr-4 text-right tabular-nums">{rupiah(f.lower)}</td>
                  <td class="py-3 pr-4 text-right tabular-nums font-bold">{rupiah(f.predicted)}</td>
                  <td class="py-3 text-right tabular-nums">{rupiah(f.upper)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {
          seri.forecast.length > barisTabel && (
            <p class="text-tinta-redup mt-3">
              Ditampilkan {barisTabel} hari pertama dari {seri.forecast.length} hari yang
              diperkirakan. Rentang yang jauh ke depan semakin tidak pasti.
            </p>
          )
        }
      </div>
    </Lipatan>
  </div>
</section>
