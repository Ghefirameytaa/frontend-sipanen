---
/**
 * ForecastChart: grafik riwayat harga dan perkiraan ke depan.
 * Grafik menampilkan rentang ketidakpastian dan angka batas bawah/atas
 * agar perkiraan tidak tampak sebagai kepastian.
 * Evaluasi akurasi model tidak ditampilkan di sini.
 */
import type { ForecastPoint, ForecastSeries } from '../lib/api';
import { rupiah, tanggalPanjang, tanggalRingkas } from '../lib/api';

export interface Props {
  seri: ForecastSeries;
  hariKerja: ForecastPoint[];
}

const { seri, hariKerja } = Astro.props;

const idUnik = `grafik-${seri.commodity_code}-${Math.random().toString(36).slice(2, 8)}`;
const idKonfigurasi = `${idUnik}-data`;

const labels = [
  ...seri.history.map((h) => tanggalRingkas(h.date)),
  ...seri.forecast.map((f) => tanggalRingkas(f.date)),
];
const tanggalGrafik = [...seri.history.map((h) => h.date), ...seri.forecast.map((f) => f.date)];

// Deret riwayat diisi sampai ujung, deret perkiraan dibiarkan kosong di bagian
// riwayat. Titik sambungnya ditambahkan oleh penggambar grafik.
const kosongRiwayat = new Array(seri.forecast.length).fill(null);
const kosongPerkiraan = new Array(seri.history.length).fill(null);

const konfigurasi = {
  labels,
  tanggal: tanggalGrafik,
  riwayat: [...seri.history.map((h) => h.price), ...kosongRiwayat],
  perkiraan: [...kosongPerkiraan, ...seri.forecast.map((f) => f.predicted)],
  atas: [...kosongPerkiraan, ...seri.forecast.map((f) => f.upper)],
  bawah: [...kosongPerkiraan, ...seri.forecast.map((f) => f.lower)],
  satuan: seri.unit || 'kg',
  judul: seri.commodity_name,
};

// `</script>` di dalam JSON akan menutup blok skrip lebih awal, jadi karakter
// `<` di-escape. Isinya sendiri hanya tanggal dan angka, tetapi datanya tetap
// diperlakukan sebagai teks yang tidak dipercaya.
const konfigurasiAman = JSON.stringify(konfigurasi).replace(/</g, '\\u003c');

const titikTerakhir = seri.forecast[seri.forecast.length - 1];
const batasBawah = hariKerja.length ? Math.min(...hariKerja.map((titik) => titik.lower)) : null;
const batasAtas = hariKerja.length ? Math.max(...hariKerja.map((titik) => titik.upper)) : null;
const tanggalAwalHariKerja = hariKerja[0]?.date;
const tanggalAkhirHariKerja = hariKerja[hariKerja.length - 1]?.date;

const puncakPerkiraan = seri.forecast.reduce<ForecastSeries['forecast'][number] | null>(
  (tertinggi, titik) => (!tertinggi || titik.predicted > tertinggi.predicted ? titik : tertinggi),
  null
);

---

<section class="space-y-6">
  <header class="border-b border-kertas-garis pb-4">
    <div class="flex flex-wrap items-center gap-4 justify-between">
      <h2 class="text-xl font-bold sm:text-2xl">
        {seri.commodity_name}
        <span class="text-tinta-redup font-medium text-sm sm:text-lg">({seri.variety})</span>
      </h2>
    </div>

  </header>

  {batasBawah !== null && batasAtas !== null && tanggalAwalHariKerja && tanggalAkhirHariKerja && (
    <article class="rounded-card border border-[#125112]/35 bg-[#E6EFE6] p-4 text-center shadow-sm dark:border-[#64902E]/60 dark:bg-[#263238] sm:p-6" aria-label={`Rentang kemungkinan harga selama ${hariKerja.length} hari kerja`}>
      <p class="mb-2 text-[10px] font-bold uppercase tracking-wide text-[#125112] dark:text-[#C0F283] sm:text-xs">Rentang harga · {hariKerja.length} hari kerja</p>
      <p class="mt-1 whitespace-nowrap font-display text-[clamp(1rem,5vw,1.5rem)] font-extrabold leading-tight tabular-nums text-tinta-utama sm:text-4xl">
        {rupiah(batasBawah)} – {rupiah(batasAtas)}<span class="text-[0.7em] font-semibold"> / {seri.unit}</span>
      </p>
      <p class="mt-2 text-[10px] text-tinta-kedua sm:text-xs">
        Periode 5 hari kerja: <time datetime={tanggalAwalHariKerja}>{tanggalPanjang(tanggalAwalHariKerja)}</time> s.d. <time datetime={tanggalAkhirHariKerja}>{tanggalPanjang(tanggalAkhirHariKerja)}</time>
      </p>
    </article>
  )}

  <div class="grid gap-4 sm:grid-cols-3">
    <article class="rounded-card border border-kertas-garis border-l-4 border-l-[#125112] bg-white p-4 shadow-sm">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-tinta-kedua">Harga terkini</h3>
      <p class="mt-1 text-xl font-extrabold tabular-nums text-[#125112] dark:text-[#C0F283]">{rupiah(seri.current_price)} / {seri.unit}</p>
      <p class="mt-1 text-sm text-tinta-kedua">{tanggalPanjang(seri.current_price_date)}</p>
    </article>

    <article class="rounded-card border border-kertas-garis border-l-4 border-l-amber-500 bg-white p-4 shadow-sm">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-tinta-kedua">Tertinggi dari 7 hari prediksi</h3>
      {puncakPerkiraan ? (
        <>
          <p class="mt-1 text-xl font-extrabold tabular-nums text-amber-800">{rupiah(puncakPerkiraan.predicted)} / {seri.unit}</p>
          <p class="mt-1 text-sm text-tinta-kedua">Perkiraan {tanggalPanjang(puncakPerkiraan.date)}</p>
        </>
      ) : <p class="mt-1 font-semibold text-tinta-kedua">Belum tersedia</p>}
    </article>

    <article class="rounded-card border border-kertas-garis border-l-4 border-l-[#125112] bg-white p-4 shadow-sm">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-tinta-kedua">Perkiraan hari ke-7</h3>
      {titikTerakhir ? (
        <>
          <p class="mt-1 text-xl font-extrabold tabular-nums text-[#125112] dark:text-[#C0F283]">{rupiah(titikTerakhir.predicted)} / {seri.unit}</p>
          <p class="mt-1 text-sm text-tinta-kedua">{tanggalPanjang(titikTerakhir.date)}</p>
        </>
      ) : <p class="mt-1 font-semibold text-tinta-kedua">Belum tersedia</p>}
    </article>
  </div>

  <section class="overflow-hidden rounded-card border border-kertas-garis bg-white p-4 shadow-sm sm:p-6" aria-labelledby={`${idUnik}-judul-grafik`}>
    <header class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-kertas-garis pb-5">
      <div>
        <h3 id={`${idUnik}-judul-grafik`} class="font-display text-xl font-bold text-tinta-utama sm:text-2xl">Tren harga {seri.commodity_name}</h3>
        <p class="mt-1 text-sm leading-relaxed text-tinta-kedua">Kurva memuat 7 hari sebelumnya dan 7 hari prediksi. Garis utuh menunjukkan harga tercatat, garis putus-putus adalah perkiraan, dan arsiran menunjukkan rentangnya.</p>
      </div>
    </header>

    <ul class="mb-4 flex flex-wrap gap-x-5 gap-y-3 text-sm text-tinta-kedua sm:text-base" aria-label="Keterangan grafik">
      <li class="flex items-center gap-2"><span class="h-3 w-4 rounded-sm border-t-2 border-[#125112] bg-[#E6EFE6] dark:bg-[#3F4A33]" aria-hidden="true"></span>Harga tercatat</li>
      <li class="flex items-center gap-2"><span class="h-0 w-7 border-t-2 border-dashed border-[#125112] dark:border-[#C0F283]" aria-hidden="true"></span>Perkiraan</li>
      <li class="flex items-center gap-2"><span class="h-3 w-4 rounded-sm bg-[#E6EFE6] dark:bg-[#3F4A33]" aria-hidden="true"></span>Rentang kemungkinan</li>
    </ul>

    <p class="mb-2 text-sm leading-relaxed text-tinta-kedua">Ketuk grafik untuk melihat tanggal dan harga.</p>
    <div class="relative h-72 sm:h-96">
      <canvas
        data-grafik="prediksi"
        data-konfigurasi={idKonfigurasi}
        role="img"
        aria-label={`Grafik harga tercatat dan perkiraan harga ${seri.commodity_name} dalam rupiah per ${seri.unit}. Nilai setiap tanggal dapat dibaca melalui grafik.`}
      ></canvas>
    </div>
    <script type="application/json" id={idKonfigurasi} set:html={konfigurasiAman} />
  </section>

</section>
