---
interface Komoditas {
  id: number;
  name: string;
}

interface Props {
  items: Komoditas[];
  selectedId: number;
}

const { items, selectedId } = Astro.props;
---

<nav aria-label="Pilih komoditas">
  <p class="mb-2 text-sm font-semibold text-tinta-utama">Komoditas</p>
  <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
    {items.map((item) => (
      <button
        type="button"
        data-pilih-komoditas={item.id}
        aria-pressed={item.id === selectedId ? 'true' : 'false'}
        class:list={[
          'inline-flex min-h-10 w-full items-center justify-center rounded-full border px-2 py-2 text-xs font-bold transition-colors sm:w-auto sm:px-4 sm:text-sm',
          item.id === selectedId
            ? 'border-[#B9D0AD] bg-[#DCE9D2] text-[#125112] hover:bg-[#C5D9BC]'
            : 'border-[#C7D2DF] bg-white text-[#344054] hover:bg-[#C5D9BC]',
        ]}
      >
        {item.name}
      </button>
    ))}
  </div>
</nav>

<script>
  function aktifkanPilihanKomoditas() {
    const root = document.querySelector<HTMLElement>('[aria-labelledby="judul-prediksi"]');
    if (!root) return;

    const tombol = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pilih-komoditas]'));
    const panel = Array.from(root.querySelectorAll<HTMLElement>('[data-panel-prediksi]'));
    if (tombol.length === 0 || panel.length === 0) return;

    tombol.forEach((button) => {
      if (button.dataset.terpasang === 'true') return;
      button.dataset.terpasang = 'true';
      button.addEventListener('click', () => {
        const selectedId = button.dataset.pilihKomoditas;
        if (!selectedId) return;

        panel.forEach((item) => {
          item.hidden = item.dataset.panelPrediksi !== selectedId;
        });

        tombol.forEach((item) => {
          const selected = item.dataset.pilihKomoditas === selectedId;
          item.setAttribute('aria-pressed', String(selected));
          item.classList.toggle('border-[#B9D0AD]', selected);
          item.classList.toggle('bg-[#DCE9D2]', selected);
          item.classList.toggle('text-[#125112]', selected);
          item.classList.toggle('border-[#C7D2DF]', !selected);
          item.classList.toggle('bg-white', !selected);
          item.classList.toggle('text-[#344054]', !selected);
        });

        const url = new URL(window.location.href);
        url.searchParams.set('bagian', 'prediksi');
        url.searchParams.set('komoditas', selectedId);
        window.history.replaceState(window.history.state, '', url);
        requestAnimationFrame(() => document.dispatchEvent(new Event('sipanen:refresh-charts')));
      });
    });
  }

  document.addEventListener('astro:page-load', aktifkanPilihanKomoditas);
  aktifkanPilihanKomoditas();
</script>
