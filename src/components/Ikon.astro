  kalender:
    '<rect x="3.2" y="5" width="17.6" height="16" rx="2.2"/><path d="M3.2 9.8h17.6"/><path d="M8 3v4M16 3v4"/><path d="M7.6 13.8h2.2M11.4 13.8h2.2M7.6 17.4h2.2M11.4 17.4h2.2"/>',
  panduan:
