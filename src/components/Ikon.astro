    '<path d="M12 8.1c-1.9-1.5-4.9-.9-6.8 1.2-2.6 2.8-1.8 7.8 1.2 10.1 2.2 1.7 3.8.5 5.6.5s3.4 1.2 5.6-.5c3-2.3 3.8-7.3 1.2-10.1-1.9-2.1-4.9-2.7-6.8-1.2Z" fill="currentColor" stroke="none"/><path d="M12 9c-.2-2.2.4-4.2 2.7-5.5-1.4 2.5-.6 3.8-.2 4.7 1.5-1.2 3.2-1.3 4.5-.8-2.2.6-3.2 1.9-3.6 3.2-1.4-.8-2.4-1.1-3.4-1.6-1.1.5-2 1.1-3.5 1.5-.4-1.4-1.4-2.2-3.2-2.8 2-.6 3.5-.2 4.7.8.1-1.5-.1-2.6-1.2-4.1C11.1 5.2 12.2 7.1 12 9Z" fill="#397a3d" stroke="none"/><path d="M8 11.4c1.1-1.1 2.3-1.4 3.3-.9" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="1.3" opacity=".5"/>',
