  'tomat-kecil':
    '<path d="M12 10.1c-1.5-1.2-3.9-.7-5.4 1-2.1 2.2-1.4 6.2 1 8.1 1.8 1.4 3 .4 4.4.4s2.7 1 4.4-.4c2.4-1.9 3.1-5.9 1-8.1-1.5-1.7-3.9-2.2-5.4-1Z" fill="currentColor" stroke="none"/><path d="M12 10.7c-.2-1.8.3-3.4 2.2-4.5-1.1 2-.5 3.1-.2 3.8 1.2-1 2.6-1 3.6-.6-1.8.5-2.6 1.5-2.9 2.6-1.1-.7-1.9-.9-2.7-1.3-.9.4-1.6.9-2.8 1.2-.3-1.1-1.1-1.8-2.6-2.3 1.6-.5 2.8-.2 3.8.6.1-1.2-.1-2.1-1-3.3 1.1.6 1.9 2.1 1.7 3.8Z" fill="#397a3d" stroke="none"/><path d="M8.8 12.6c.9-.9 1.8-1.1 2.6-.7" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="1.1" opacity=".5"/>',

  // ── Perubahan harga ───────────────────────────────────────────────────────
