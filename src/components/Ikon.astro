/**
 * Nama lain untuk ikon yang sama.
 *
 * Dipakai agar pemanggil dapat memakai istilah yang paling masuk akal di
 * tempatnya — mis. fase kalender bernama `persiapan`, `pemupukan`, dan
 * `panen` — tanpa perlu tahu nama ikonnya.
 */
const ALIAS: Record<string, string> = {
  barn: 'beranda',
  buku: 'panduan',
  bulb: 'saran',
  dslr: 'scan-frame',
  growth: 'grafik',
  panen: 'keranjang',
  'price-tag': 'harga',
  'open-book': 'panduan',
  'prediksi-harga': 'prediksi',
  calendar: 'kalender',
  pupuk: 'semprot',
  pemupukan: 'semprot',
  persiapan: 'cangkul',
  tanam: 'bibit',
  perawatan: 'air',
  curah_hujan: 'hujan',
  ketinggian: 'gunung',
  harga_naik: 'panah-naik',
  harga_turun: 'panah-turun',
  waktu: 'jam',
};

const kunci = ALIAS[nama] ?? nama;
const isi = IKON[kunci] ?? IKON.tanya;
const asetKomoditas: Record<string, string> = {
  'cabai-keriting': '/komoditas/cabai-rawit-merah.png',
  'cabai-rawit-merah': '/komoditas/cabai-merah-keriting.png',
  'cabai-rawit-hijau': '/komoditas/cabai-rawit-hijau.png',
  tomat: '/komoditas/tomat.svg',
  'tomat-besar': '/komoditas/tomat.svg',
  'tomat-kecil': '/komoditas/tomat-kecil.png',
};
const sumberAset = inline ? undefined : asetKomoditas[kunci];
---

{sumberAset ? (
  <img
    src={sumberAset}
    width={ukuran}
    height={ukuran}
    class:list={['shrink-0 object-contain', kelas]}
    alt=""
    aria-hidden="true"
  />
) : (
<svg
  width={ukuran}
  height={ukuran}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['ikon-svg shrink-0', kelas]}
  aria-hidden="true"
  focusable="false"
  set:html={isi}
/>
)}
