---
/**
 * Ikon — seluruh ikon SVG dashboard.
 *
 * MENGAPA DIGAMBAR SENDIRI, BUKAN EMOJI ATAU GAMBAR DARI INTERNET
 * --------------------------------------------------------------
 * Demo KKN sering berjalan di tempat yang sambungan internetnya lemah atau
 * diblokir. Emoji juga tampil berbeda-beda antar perangkat: di sebagian ponsel
 * lama, emoji yang tidak dikenal muncul sebagai kotak kosong. Ikon SVG yang
 * ditanam di dalam kode tampil sama persis di mana pun, tanpa memuat apa pun.
 *
 * ATURAN PEMAKAIAN
 * ----------------
 * Ikon TIDAK PERNAH berdiri sendiri. Selalu ada kata di sebelahnya yang
 * membawa maknanya. Karena itu seluruh ikon di sini memakai
 * `aria-hidden="true"` — pembaca layar melewatinya dan langsung membaca
 * teksnya, bukan mendengar "grafik, grafik, grafik".
 *
 * Untuk alasan yang sama, ukuran ikon tidak pernah dipakai untuk membedakan
 * arti. Ikon cabai tetap cabai apakah ditampilkan 20px atau 56px.
 */

export interface Props {
  nama: string;
  /** Sisi ikon dalam piksel. */
  ukuran?: number;
  /** Kelas tambahan, mis. untuk mengatur warna lewat `text-*`. */
  kelas?: string;
  /** Paksa SVG inline pada permukaan yang memerlukan ikon outline. */
  inline?: boolean;
}

const { nama, ukuran = 24, kelas = '', inline = false } = Astro.props;

/**
 * Isi tiap ikon. Semuanya memakai kanvas 24×24 dan goresan monokrom membulat.
 *
 * Seluruh nilai di bawah ini ditulis tangan di dalam berkas ini — tidak ada
 * masukan dari pengguna — sehingga aman disisipkan sebagai HTML.
 */
