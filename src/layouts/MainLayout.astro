    <script data-astro-rerun>
      (function () {
        var root = document.documentElement;
        var toggle = document.querySelector('[data-theme-toggle]');
        var header = document.querySelector('[data-site-header]');
        var stored = localStorage.getItem('sipanen-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        function setTheme(theme) {
          var dark = theme === 'dark';
          root.classList.toggle('dark', dark);
          if (header) {
            header.setAttribute('data-theme', dark ? 'dark' : 'light');
          }
          document.dispatchEvent(new CustomEvent('sipanen:theme-change'));
          if (toggle) {
            toggle.setAttribute('aria-label', dark ? 'Aktifkan tema terang' : 'Aktifkan tema gelap');
            toggle.setAttribute('aria-pressed', String(dark));
            toggle.querySelector('.theme-icon-light').classList.toggle('hidden', dark);
            toggle.querySelector('.theme-icon-dark').classList.toggle('hidden', !dark);
          }
        }

        setTheme(stored || (prefersDark ? 'dark' : 'light'));
        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = root.classList.contains('dark') ? 'light' : 'dark';
            localStorage.setItem('sipanen-theme', next);
            setTheme(next);
          });
        }
      })();

      // Animasi muncul saat elemen masuk layar. Dipakai elemen bertanda
      // `data-animasi`. Bila pengguna memilih reduce-motion, elemen langsung
      // ditampilkan tanpa animasi sama sekali.
      //
      // `data-astro-rerun` diperlukan karena halaman berpindah lewat View
      // Transitions: tanpa penanda itu, skrip ini hanya berjalan sekali dan
      // elemen pada halaman berikutnya tidak pernah muncul — tertinggal
      // dalam keadaan transparan.
      //
      // Ditulis sebagai JavaScript biasa (bukan TypeScript) karena penanda
      // `data-astro-rerun` membuat Astro memperlakukan skrip ini sebagai
      // `is:inline`, sehingga tidak diproses lebih lanjut.
      var kurangiGerak = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function tampilkan(el) {
        el.classList.remove('opacity-0', 'translate-y-3');
      }

      if (kurangiGerak) {
        document.querySelectorAll('[data-animasi]').forEach(tampilkan);
      } else {
        var pengamat = new IntersectionObserver(
          function (entri) {
            for (var i = 0; i < entri.length; i++) {
              if (entri[i].isIntersecting) {
                tampilkan(entri[i].target);
                pengamat.unobserve(entri[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.05 }
        );
        document.querySelectorAll('[data-animasi]').forEach(function (el, i) {
          el.classList.add('opacity-0', 'translate-y-3');
          el.style.transitionDelay = Math.min(i * 60, 300) + 'ms';
          pengamat.observe(el);
        });
      }
    </script>

    <!--
      Penggambar grafik. Skrip ini diproses dan digabung oleh Astro, sehingga
      Chart.js ikut terbundel dan tidak bergantung pada CDN. Ia hanya berjalan
      sekali; pendaftaran ke kejadian `astro:page-load` di dalamnya yang
      membuat grafik tetap tergambar pada perpindahan halaman berikutnya.
    -->
    <script>
      import '../lib/grafik';
    </script>

