      html.dark textarea {
        background-color: #4D4D4D;
        color: #F8F9FA;
        border-color: #717171;
      }

      html.dark .shadow-sm,
      html.dark .shadow-lg,
      html.dark .shadow-xl {
        --tw-shadow-color: rgba(38, 50, 56, 0.38);
      }

      #pd-plant-tomat,
      #pd-plant-cabai {
        box-shadow: 0 3px 8px rgba(38, 50, 56, 0.2);
        transition: box-shadow 180ms ease, transform 180ms ease;
      }

      #pd-plant-tomat:hover,
      #pd-plant-cabai:hover {
        background-color: #CFEB73;
        box-shadow: 0 8px 18px rgba(38, 50, 56, 0.35);
        transform: translateY(-2px);
      }

      html.dark #pd-plant-tomat,
      html.dark #pd-plant-cabai {
        box-shadow: 0 3px 8px rgba(38, 50, 56, 0.34);
      }

      html.dark #pd-plant-tomat:hover,
      html.dark #pd-plant-cabai:hover {
        background-color: #5A5F4B;
        box-shadow: 0 8px 20px rgba(38, 50, 56, 0.58);
      }

      .rounded-panel,
      .rounded-card {
        box-shadow: 0 8px 24px rgba(38, 50, 56, 0.07);
        transition: box-shadow 200ms ease, transform 200ms ease, border-color 200ms ease;
      }

      html.dark .rounded-panel,
      html.dark .rounded-card {
        box-shadow: 0 10px 28px rgba(38, 50, 56, 0.22);
      }

      @media (hover: hover) and (pointer: fine) {
        .rounded-card:hover {
          box-shadow: 0 14px 30px rgba(38, 50, 56, 0.12);
        }

        html.dark .rounded-card:hover {
          box-shadow: 0 14px 30px rgba(38, 50, 56, 0.34);
        }
      }

      /* Seluruh transisi dihentikan bila pengguna memintanya. Ini bukan
         hiasan: animasi yang tidak dapat dimatikan dapat membuat pusing
         sebagian pengguna lanjut usia. */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      [data-animasi] {
        transition:
          opacity 300ms ease-out,
          transform 300ms ease-out;
      }

      ::selection {
        background-color: theme('colors.sipanen.200');
        color: theme('colors.sipanen.950');
      }

      /* Cincin fokus yang jelas dan tebal, agar pengguna yang menavigasi
         dengan papan ketik selalu tahu di mana posisinya. */
      :focus-visible {
        outline: 3px solid theme('colors.sipanen.700');
        outline-offset: 2px;
        border-radius: 4px;
      }

      html,
      body {
        scrollbar-width: none;
      }

      html::-webkit-scrollbar,
      body::-webkit-scrollbar {
        display: none;
      }
    </style>
  </body>
</html>
