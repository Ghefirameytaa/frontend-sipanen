---
/**
 * MainLayout — navigasi, tipografi, dan kerangka halaman SiPanen.
 */
// Astro 4 mengekspor komponen ini sebagai `ViewTransitions`; pada Astro 5
// namanya berganti menjadi `ClientRouter`. Yang dipakai di sini adalah nama
// versi Astro yang terpasang.
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/inter';
import Ikon from '../components/Ikon.astro';
import Lipatan from '../components/Lipatan.astro';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'SiPanen — informasi harga, prediksi, dan jadwal tanam untuk petani Desa Blederan, Kecamatan Mojotengah, Kabupaten Wonosobo.',
} = Astro.props;

const tautan = [
  { href: '/', label: 'Beranda', ikon: 'beranda' },
  { href: '/harga', label: 'Harga', ikon: 'harga' },
  { href: '/kalender', label: 'Kalender', ikon: 'kalender' },
  { href: '/scan-penyakit', label: 'Penyakit', ikon: 'scan-frame' },
  { href: '/edukasi', label: 'Edukasi', ikon: 'panduan' },
];

const jalur = Astro.url.pathname;
function aktif(href: string): boolean {
  if (href === '/') return jalur === '/';
  if (href === '/harga') {
    return ['/harga', '/prediksi'].some(
      (path) => jalur === path || jalur.startsWith(`${path}/`)
    );
  }
  if (href === '/kalender') {
    return ['/kalender', '/rekomendasi-tanam', '/recommendations'].some(
      (path) => jalur === path || jalur.startsWith(`${path}/`)
    );
  }
  return jalur === href || jalur.startsWith(`${href}/`);
}
---
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
