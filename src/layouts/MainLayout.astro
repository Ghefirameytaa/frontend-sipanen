        html.dark .rounded-card:hover {
          box-shadow: 0 14px 30px rgba(38, 50, 56, 0.34);
        }
      }

      /* Seluruh transisi dihentikan bila pengguna memintanya. Ini bukan
         hiasan: animasi yang tidak dapat dimatikan dapat membuat pusing
         sebagian pengguna lanjut usia. */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      [data-animasi] {
        transition:
          opacity 300ms ease-out,
          transform 300ms ease-out;
      }

      ::selection {
        background-color: theme('colors.sipanen.200');
        color: theme('colors.sipanen.950');
      }

      /* Cincin fokus yang jelas dan tebal, agar pengguna yang menavigasi
         dengan papan ketik selalu tahu di mana posisinya. */
      :focus-visible {
        outline: 3px solid theme('colors.sipanen.700');
        outline-offset: 2px;
        border-radius: 4px;
      }

      header[data-site-header] [data-header-link]:focus-visible,
      header[data-site-header] [data-header-control]:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.5) !important;
        outline-offset: 2px !important;
        border-radius: 9999px !important;
        box-shadow: 0 0 0 4px rgb(18 81 18 / 78%) !important;
      }

      :root {
        --sp-ink: #263238;
        --sp-text: #4D4D4D;
        --sp-muted: #717171;
        --sp-line: #ABBED1;
        --sp-paper: #FFFFFF;
        --sp-canvas: #F8F9FA;
        --sp-primary: #28CBB8;
        --sp-primary-deep: #167D72;
        --sp-hover: #CFEB73;
        --sp-focus: #309CF6;
        --sp-shadow: 0 8px 24px rgb(38 50 56 / 8%);
      }

      html.dark {
        --sp-ink: #F8F9FA;
        --sp-text: #E2E7EA;
        --sp-muted: #ABBED1;
        --sp-line: #89939E;
        --sp-paper: #303B40;
        --sp-canvas: #263238;
        --sp-primary: #67D9CC;
        --sp-primary-deep: #263238;
        --sp-hover: #5A5F4B;
        --sp-shadow: 0 8px 24px rgb(0 0 0 / 20%);
      }

      body {
        background: var(--sp-canvas);
        color: var(--sp-ink);
        line-height: 1.55;
      }

      h1, h2, h3, h4 {
        letter-spacing: -0.025em;
        text-wrap: balance;
      }

      p, li {
        text-wrap: pretty;
      }

      :where(button, input, select, textarea) {
        font: inherit;
      }

      :where(button, a, summary, input, select, textarea) {
        -webkit-tap-highlight-color: transparent;
      }

      :where(button, a, summary, input, select, textarea):focus-visible {
        outline-color: var(--sp-focus);
      }

      :where(a, button, summary, [role="button"], input, select, textarea) {
        transition-duration: 160ms;
      }

      :where(input, select, textarea) {
        max-width: 100%;
        border-color: var(--sp-line);
        border-radius: 0.625rem;
      }

      /* Give every native disclosure a visible, theme-safe control boundary. */
      :where(body details > summary:not([data-header-control])) {
        display: inline-flex;
        width: fit-content;
        max-width: 100%;
        align-items: center;
        border: 1px solid var(--sp-line);
        border-radius: 0.625rem;
        padding: 0.5rem 0.75rem;
        transition: border-color 160ms ease, background-color 160ms ease;
      }

      :where(body details > summary:not([data-header-control]):hover) {
        border-color: #64902E;
      }

      :where(body details[open] > summary:not([data-header-control])) {
        border-color: #64902E;
      }

      :where(select:hover) {
        border-color: #64902E;
      }

      :where(select:focus-visible) {
        border-color: var(--sp-focus);
      }

      html.dark :where(body details > summary:not([data-header-control]):hover),
      html.dark :where(body details[open] > summary:not([data-header-control])) {
        border-color: #C0F283;
      }

      html.dark :where(select:hover) {
        border-color: #C0F283;
      }

      html.dark :where(select:focus-visible) {
        border-color: #75BEFF;
      }

      @supports (interpolate-size: allow-keywords) {
        :where(body details) {
          interpolate-size: allow-keywords;
        }

        :where(body details::details-content) {
          block-size: 0;
          overflow: clip;
          transition: block-size 220ms ease, content-visibility 220ms allow-discrete;
        }

        :where(body details[open]::details-content) {
          block-size: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :where(body details > summary:not([data-header-control])) {
          transition: none;
        }
      }

      :where(img, svg, video, canvas) {
        max-width: 100%;
      }

      .rounded-card,
      .rounded-panel {
        box-shadow: var(--sp-shadow);
      }

      header[data-site-header] {
        background: var(--nav-background);
        box-shadow: 0 1px 8px rgb(38 50 56 / 12%);
      }

      html.dark header[data-site-header] {
        background: var(--nav-background);
      }

      header[data-site-header] [data-header-desktop-nav] [data-header-link]:not(.nav-aktif):hover {
        background: var(--nav-hover-background);
        color: #FFFFFF;
      }

      header[data-site-header] [data-header-desktop-nav] [data-header-link]:hover {
        border-color: transparent !important;
      }

      header[data-site-header] a:hover,
      header[data-site-header] summary:hover {
        transform: none;
        box-shadow: none;
      }

      header[data-site-header] > div > div > nav .nav-aktif {
        background: var(--nav-active-background);
        color: #FFFFFF;
        border-color: transparent !important;
      }

      header[data-site-header] .nav-aktif:hover {
        border-color: transparent !important;
      }

      header[data-site-header] details nav .nav-aktif {
        background-color: var(--nav-active-background);
        color: #FFFFFF;
        border-color: transparent;
      }

      html.dark header[data-site-header] details nav .nav-aktif {
        background-color: var(--nav-active-background);
        color: #FFFFFF;
      }

      html.dark .bg-amber-50,
      html.dark .bg-amber-100,
      html.dark .bg-yellow-50,
      html.dark .bg-yellow-100 { background-color: #51472D; }

      html.dark .bg-green-50,
      html.dark .bg-green-100,
      html.dark .bg-lime-50,
      html.dark .bg-lime-100,
      html.dark .bg-emerald-50,
      html.dark .bg-emerald-100 { background-color: #29453A; }

      html.dark .bg-sky-50,
      html.dark .bg-sky-100,
      html.dark .bg-blue-50,
      html.dark .bg-blue-100,
      html.dark .bg-cyan-50,
      html.dark .bg-cyan-100 { background-color: #293F50; }

      html.dark .bg-red-50,
      html.dark .bg-red-100,
      html.dark .bg-rose-50,
      html.dark .bg-rose-100 { background-color: #513434; }

      html.dark :where(.bg-amber-50, .bg-amber-100, .bg-yellow-50, .bg-yellow-100,
        .bg-green-50, .bg-green-100, .bg-lime-50, .bg-lime-100,
        .bg-emerald-50, .bg-emerald-100, .bg-sky-50, .bg-sky-100,
        .bg-blue-50, .bg-blue-100, .bg-cyan-50, .bg-cyan-100,
        .bg-red-50, .bg-red-100, .bg-rose-50, .bg-rose-100) {
        color: #F8F9FA;
        border-color: #717171;
      }

      @media (max-width: 640px) {
        main { width: 100%; }
        [data-page-hero] { border-radius: 1rem; }
        :where(.rounded-card, .rounded-panel) { border-radius: 0.875rem; }
      }

      html.dark .bg-white,
      html.dark .bg-kertas { background-color: #303B40; }

      html.dark [class*="bg-gray-50"],
      html.dark [class*="bg-gray-100"],
      html.dark [class*="bg-slate-50"],
      html.dark [class*="bg-slate-100"],
      html.dark [class*="bg-stone-50"],
      html.dark [class*="bg-stone-100"] { background-color: #3A4449; }

      html.dark [class*="bg-sipanen-50"],
      html.dark [class*="bg-sipanen-100"],
      html.dark [class*="bg-sipanen-200"],
      html.dark [class*="bg-lime-50"],
      html.dark [class*="bg-lime-100"] { background-color: #3F4A33; }

      html.dark [class*="bg-green-50"],
      html.dark [class*="bg-green-100"],
      html.dark [class*="bg-emerald-50"],
      html.dark [class*="bg-emerald-100"] { background-color: #29453A; }

      html.dark [class*="bg-amber-50"],
      html.dark [class*="bg-amber-100"],
      html.dark [class*="bg-amber-200"],
      html.dark [class*="bg-yellow-50"],
      html.dark [class*="bg-yellow-100"],
      html.dark [class*="bg-yellow-200"] { background-color: #51472D; }

      html.dark [class*="bg-red-50"],
      html.dark [class*="bg-red-100"],
      html.dark [class*="bg-red-200"],
      html.dark [class*="bg-rose-50"],
      html.dark [class*="bg-rose-100"],
      html.dark [class*="bg-rose-200"],
      html.dark [class*="bg-bahaya-50"],
      html.dark [class*="bg-bahaya-100"],
      html.dark [class*="bg-bahaya-200"] { background-color: #513434; }

      html.dark [class*="bg-blue-50"],
      html.dark [class*="bg-blue-100"],
      html.dark [class*="bg-blue-200"],
      html.dark [class*="bg-sky-50"],
      html.dark [class*="bg-sky-100"],
      html.dark [class*="bg-sky-200"],
      html.dark [class*="bg-cyan-50"],
      html.dark [class*="bg-cyan-100"],
      html.dark [class*="bg-cyan-200"] { background-color: #293F50; }

      html.dark [class*="text-amber-"],
      html.dark [class*="text-yellow-"] { color: #FFD95C; }

      html.dark [class*="text-red-"],
      html.dark [class*="text-rose-"],
      html.dark [class*="text-bahaya-"] { color: #FF8A84; }

      html.dark [class*="text-blue-"],
      html.dark [class*="text-sky-"],
      html.dark [class*="text-cyan-"] { color: #75BEFF; }

      html.dark [class*="text-green-"],
      html.dark [class*="text-emerald-"] { color: #9BDBA7; }

      html.dark [class*="text-lime-"],
      html.dark [class*="text-sipanen-"] { color: #C0F283; }

      html.dark [class*="text-gray-"],
      html.dark [class*="text-slate-"],
      html.dark [class*="text-stone-"] { color: #E2E7EA; }

      html.dark [class*="border-red-"],
      html.dark [class*="border-rose-"],
      html.dark [class*="border-bahaya-"] { border-color: #A95752; }

      html.dark [class*="border-amber-"],
      html.dark [class*="border-yellow-"] { border-color: #8A7644; }

      html.dark [class*="border-blue-"],
      html.dark [class*="border-sky-"],
      html.dark [class*="border-cyan-"] { border-color: #52748D; }

      html.dark [class*="border-green-"],
      html.dark [class*="border-emerald-"],
      html.dark [class*="border-lime-"],
      html.dark [class*="border-sipanen-"] { border-color: #647A45; }

      @media (hover: hover) and (pointer: fine) {
        [class*="hover:-translate-y"]:hover { --tw-translate-y: -2px; }
      }

    </style>
  </body>
</html>
